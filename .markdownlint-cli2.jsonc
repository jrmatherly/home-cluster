{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "gitignore": true,
  "globs": ["**/*.md"],
  // A Nimbus starter file, kept byte-identical to upstream so `nimbus-docs diff --apply` can move it.
  // skill-stack.md is generated by claude-stack and ignored only by the user's global gitignore.
  "ignores": ["docs/AGENT.md", ".claude/rules/skill-stack.md"],
  "config": {
    // oxfmt owns layout and does not wrap prose.
    "MD013": false,
    // Matches .editorconfig and oxfmt: Markdown indents by 4.
    "MD007": { "indent": 4 },
    // Two GitHub alerts in a row need a blank line between them.
    "MD028": false,
    "MD033": { "allowed_elements": ["a", "img", "kbd", "p"] }
  }
}
