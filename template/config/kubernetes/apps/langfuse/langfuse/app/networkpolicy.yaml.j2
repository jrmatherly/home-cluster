#% if langfuse_enabled %#
---
# The UI comes in through the gateway, and traces from namespaces that opt in
# with the label below. The worker serves nothing anyone needs.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: langfuse
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: langfuse
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
        - namespaceSelector:
            matchLabels:
              langfuse.tracing/client: "true"
      ports:
        - protocol: TCP
          port: 3000
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: clickhouse
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: clickhouse
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - podSelector: {}
      ports:
        - protocol: TCP
          port: 8123
        - protocol: TCP
          port: 9000
#% endif %#
