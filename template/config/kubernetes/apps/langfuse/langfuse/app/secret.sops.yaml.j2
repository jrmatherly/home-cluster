#% if langfuse_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-secret
stringData:
  SALT: "#{ langfuse.salt }#"
  ENCRYPTION_KEY: "#{ langfuse.encryption_key }#"
  NEXTAUTH_SECRET: "#{ langfuse.nextauth_secret }#"
  AUTH_CUSTOM_CLIENT_SECRET: "#{ langfuse.oidc_client_secret }#"
  S3_ACCESS_KEY: "#{ langfuse.rustfs_access_key }#"
  S3_SECRET_KEY: "#{ langfuse.rustfs_secret_key }#"
  LANGFUSE_INIT_PROJECT_PUBLIC_KEY: "#{ langfuse.public_key }#"
  LANGFUSE_INIT_PROJECT_SECRET_KEY: "#{ langfuse.secret_key }#"
#% endif %#
