#% if langfuse_enabled %#
---
# Its own Secret, so rotating a Langfuse key does not restart the only ClickHouse replica.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: clickhouse-auth
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: clickhouse-auth
    creationPolicy: Owner
    template:
      data:
        password: "{{ .CLICKHOUSE_PASSWORD }}"
  dataFrom:
    - extract:
        key: langfuse
#% endif %#
