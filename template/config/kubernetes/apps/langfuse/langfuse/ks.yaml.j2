#% if langfuse_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: langfuse
spec:
  dependsOn:
    - name: cloudnative-pg
      namespace: cnpg-system
    - name: plugin-barman-cloud
      namespace: cnpg-system
    # Every ingested event is written to the bucket first, so the key pair has to exist.
    - name: rustfs-provision
      namespace: rustfs
  interval: 1h
  path: ./kubernetes/apps/langfuse/langfuse/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: langfuse
  wait: false
#% endif %#
