#% if itsaplan_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: itsaplan
spec:
  chartRef:
    kind: OCIRepository
    name: itsaplan
  interval: 1h
  # The first install waits for itsaplan-db, then the migrate init container
  # applies every migration (196 at 1.13.0) and the api's readiness probe
  # starts 60 s later, so Helm's default 5m can run out on a fresh cluster.
  timeout: 10m
  valuesFrom:
    # CloudNativePG generates this Secret. The uri key is the whole libpq
    # connection string, so no database password lives in the vault.
    - kind: Secret
      name: itsaplan-db-app
      valuesKey: uri
      targetPath: externalDatabase.url
    - kind: Secret
      name: itsaplan-secret
      valuesKey: values.yaml
  values:
    # The images set no USER; measured as 1001 on a read-only root in Docker.
    podSecurityContext:
      runAsNonRoot: true
      runAsUser: 1001
      runAsGroup: 1001
      fsGroup: 1001
      seccompProfile: { type: RuntimeDefault }
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      capabilities: { drop: ["ALL"] }
    api:
      image:
        repository: ghcr.io/jrmatherly/itsaplan-api
        tag: 1.14.0@sha256:bcd89b628cd475d682d9ceae778142aad56d4f2972b9ecebf1b717e632402320
      env:
        API_URL: https://plan.${SECRET_DOMAIN}/api
        APP_URL: https://plan.${SECRET_DOMAIN}
#% if itsaplan.git_webhooks %#
        # The payload URL the app registers with a Git host. Without it the app
        # would use API_URL, whose /api prefix the public route does not serve.
        GIT_WEBHOOK_BASE_URL: https://plan.${SECRET_DOMAIN}
#% endif %#
        S3_BUCKET: #{ (rustfs_consumers | selectattr("name", "equalto", "itsaplan") | first).bucket }#
        S3_REGION: us-east-1
        S3_FORCE_PATH_STYLE: "true"
        # Otherwise the migrate init container dumps the database before an
        # upgrade into the chart's emptyDir at /backups, which dies with the pod.
        # itsaplan-db's WAL archiving and daily backup are the safety net.
        SKIP_PRE_MIGRATION_BACKUP: "1"
        TELEMETRY_DISABLED: "1"
#% if firecrawl_enabled %#
        # Lets the agents' Firecrawl tools call the in-cluster instance over plain http.
        # No port: an entry with one matches nothing. Every outbound path of the app
        # that reads this list trusts the host, webhooks and attachment import included.
        SSRF_ALLOWED_HOSTS: http://firecrawl-api.firecrawl.svc.cluster.local
#% endif %#
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          memory: 1Gi
    web:
      image:
        repository: ghcr.io/jrmatherly/itsaplan-web
        tag: 1.14.0@sha256:f2f52b56589a9094d9c721a0636a183606f51ddc8b90f14dfb7fd2f514af6481
      resources:
        requests:
          cpu: 50m
          memory: 256Mi
        limits:
          memory: 1Gi
    worker:
      image:
        repository: ghcr.io/jrmatherly/itsaplan-worker
        tag: 1.14.0@sha256:73de193ce316e518542c03923aaef95037b66bab73c37cb273428d6607b08053
      env:
        DO_NOT_TRACK: "1"
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          memory: 512Mi
    # The Telegram bot, not used.
    bot:
      enabled: false
    postgresql:
      enabled: false
    # A placeholder so flate can render the chart offline, which requires a
    # database when postgresql is off; the valuesFrom targetPath above
    # overwrites it, inline values included, with the CloudNativePG Secret at
    # reconcile time.
    externalDatabase:
      url: postgresql://flate-placeholder
    minio:
      enabled: false
    externalS3:
      endpoint: http://rustfs-svc.rustfs.svc.cluster.local:9000
    # ingress and certificate stay at their defaults (off): the HTTPRoute is the route.
#% endif %#
