#% if itsaplan_enabled %#
---
# A whole values document, because Flux splits a targetPath value on commas.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: itsaplan
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: itsaplan-secret
    creationPolicy: Owner
    template:
      data:
        values.yaml: |
          secrets:
            betterAuthSecret: "{{ .BETTER_AUTH_SECRET }}"
            appEncryptionKey: "{{ .APP_ENCRYPTION_KEY }}"
            s3AccessKeyId: "{{ .RUSTFS_ACCESS_KEY }}"
            s3SecretAccessKey: "{{ .RUSTFS_SECRET_KEY }}"
#% if itsaplan.web_push %#
            webPushVapidPrivateKey: "{{ .WEB_PUSH_VAPID_PRIVATE_KEY }}"
          # The public key and the contact are not secrets. They come from the
          # vault so the contact address stays out of Git.
          api:
            env:
              WEB_PUSH_VAPID_PUBLIC_KEY: "{{ .WEB_PUSH_VAPID_PUBLIC_KEY }}"
              WEB_PUSH_SUBJECT: "{{ .WEB_PUSH_SUBJECT }}"
#% endif %#
  dataFrom:
    - extract:
        key: itsaplan
#% endif %#
