#% if itsaplan_enabled %#
---
# A whole values document, because Flux splits a targetPath value on commas.
apiVersion: v1
kind: Secret
metadata:
  name: itsaplan-secret
stringData:
  values.yaml: |
    secrets:
      betterAuthSecret: "#{ itsaplan.better_auth_secret }#"
      appEncryptionKey: "#{ itsaplan.app_encryption_key }#"
      s3AccessKeyId: "#{ itsaplan.rustfs_access_key }#"
      s3SecretAccessKey: "#{ itsaplan.rustfs_secret_key }#"
#% endif %#
