#% if network_optimizer_enabled and volume_backup_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: volume-backup
stringData:
  ENDPOINT_HOST: "#{ postgres.backup.endpoint | replace('https://', '') }#"
  BUCKET: "#{ volume_backup.bucket }#"
  ACCESS_KEY: "#{ volume_backup.access_key }#"
  SECRET_KEY: "#{ volume_backup.secret_key }#"
#% endif %#
