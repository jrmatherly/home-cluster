#% if network_optimizer_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: network-optimizer
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: network-optimizer-secret
    creationPolicy: Owner
    template:
      data:
        APP_PASSWORD: "{{ .APP_PASSWORD }}"
        #% if network_optimizer_oidc %#
        NETOPT_FED_POCKET_ID_SECRET: "{{ .OIDC_CLIENT_SECRET }}"
        #% endif %#
  dataFrom:
    - extract:
        key: network-optimizer
#% endif %#
