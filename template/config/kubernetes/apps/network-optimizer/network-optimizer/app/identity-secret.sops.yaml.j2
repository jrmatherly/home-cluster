#% if network_optimizer_oidc %#
---
# The client secret is not in this file: the app reads it from
# NETOPT_FED_POCKET_ID_SECRET in network-optimizer-secret, which wins over the file.
apiVersion: v1
kind: Secret
metadata:
  name: network-optimizer-identity
stringData:
  identity.json: |
    {
      "providers": [
        {
          "scheme": "pocket-id",
          "type": "Oidc",
          "displayName": "Pocket ID",
          "enabled": true,
          "authority": "https://auth.${SECRET_DOMAIN}",
          "clientId": "#{ network_optimizer.oidc_client_id }#",
          "scopes": "openid profile email groups",
          "groupsClaim": "groups",
          "jitProvisioning": "CreateOnFirstLogin",
          "roleMappingMode": "Manual"
        }
      ]
    }
#% endif %#
