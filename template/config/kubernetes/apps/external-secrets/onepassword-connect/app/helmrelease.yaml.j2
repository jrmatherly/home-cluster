#% if onepassword_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: onepassword-connect
spec:
  chartRef:
    kind: OCIRepository
    name: onepassword-connect
  interval: 1h
  values:
    connect:
      # The bootstrap recipe creates this Secret. The chart creates none.
      credentialsName: onepassword-connect-credentials
      credentialsKey: 1password-credentials.json
#% endif %#
