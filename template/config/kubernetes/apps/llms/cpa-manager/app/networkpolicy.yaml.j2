#% if cliproxyapi_enabled %#
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cpa-manager
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cpa-manager
      app.kubernetes.io/controller: cpa-manager
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
      ports:
        - protocol: TCP
          port: 18317
#% endif %#
