#% if cliproxyapi_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cpa-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: cpa-manager-secret
    creationPolicy: Owner
    template:
      data:
        CPA_MANAGEMENT_KEY: "{{ .MANAGEMENT_KEY }}"
        CPA_MANAGER_ADMIN_KEY: "{{ .MANAGER_ADMIN_KEY }}"
  dataFrom:
    - extract:
        key: cliproxyapi
#% endif %#
