#% if cliproxyapi_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: cliproxyapi-secret
stringData:
  # Seeded onto the volume once; the app owns the copy there.
  config.yaml: |
    config-version: 8
    server:
      # Without it the app binds :0 (measured live), not 8317.
      port: 8317
      # The gateway forwards the client address, and the app bans an address after five bad management keys.
      trusted-proxies: ["#{ kubernetes.pod_cidr }#"]
    management:
      allow-remote: true
      secret-key: "#{ cliproxyapi.management_key }#"
      # The manager replaces the bundled panel, which the app would otherwise download from GitHub.
      disable-control-panel: true
    access:
      api-keys:
        - "#{ cliproxyapi.api_key }#"
    oauth:
      auth-dir: /data/auths
    routing:
      session-affinity: true
    observability:
      logs:
        logging-to-file: false
      usage:
        # The manager's usage pages read this queue.
        usage-statistics-enabled: true
#% endif %#
