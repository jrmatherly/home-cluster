#% if cliproxyapi_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: cliproxyapi-secret
stringData:
  # Seeded onto the volume once; the app owns the copy there.
  config.yaml: |
    config-version: 8
    server:
      # Without it the app binds :0 (measured live), not 8317.
      port: 8317
#% if cliproxyapi.github_token %#
      # Plugin store release lookups; unauthenticated GitHub allows 60 requests an hour.
      github-token: "#{ cliproxyapi.github_token }#"
#% endif %#
      # The gateway forwards the client address, and the app bans an address after five bad management keys.
      trusted-proxies: ["#{ kubernetes.pod_cidr }#"]
    management:
      allow-remote: true
      secret-key: "#{ cliproxyapi.management_key }#"
      # The manager replaces the bundled panel, which the app would otherwise download from GitHub.
      disable-control-panel: true
    access:
      api-keys:
        - "#{ cliproxyapi.api_key }#"
    oauth:
      auth-dir: /data/auths
    plugins:
      # Off by default upstream, and the manager hides its Plugins page while it is off.
      enabled: true
      # The default "plugins" is under the read-only image root; a store install writes here.
      dir: /data/plugins
      # Oh-My-CPA's own registry; its "plugin registry" setting re-adds it on every start.
      store-sources:
        - "https://raw.githubusercontent.com/omc-community/omc-plugins/main/registry.json"
      # The .so lives on the volume (store install, not in Git); this keeps it enabled across a
      # re-seed. The store writes its own metadata block on install. Settings are the defaults.
      configs:
        claude-seat-pacer:
          enabled: true
    routing:
      # Each login's weight lives in its token file, set in the manager (not in Git).
      strategy: weighted-round-robin
      session-affinity: true
      # A transient 5xx keeps the session on its login (and its prompt cache); 429 and auth errors rebind.
      session-affinity-rebind-on: quota
      cooldown:
        # Keeps a throttled login out of rotation across a restart (.cds files in auth-dir).
        save-cooldown-status: true
      retry:
        # The documented defaults; the loader applies none when the keys are absent, and the
        # management API then reports 0 rounds.
        request-retry: 3
        max-retry-interval: 30
    upstream:
      claude:
        # A Fable weekly 429 cools only Fable on that login, not every model.
        model-level-cooling: true
        header-defaults:
          # The cloaked currentDate for non-Claude-Code clients; the fallback is Asia/Singapore.
          timezone: America/New_York
    requests:
      # Blank lines keep a long non-streaming answer alive through the gateway's idle timeout.
      nonstream-keepalive-interval: 30
    observability:
      logs:
        # Rotating files under the auth dir (the image root is read-only), which the consoles' Logs
        # pages read; stdout goes quiet.
        logging-to-file: true
        logs-max-total-size-mb: 100
      usage:
        # The manager's usage pages read this queue; an hour (the maximum) survives a manager restart.
        usage-statistics-enabled: true
        redis-usage-queue-retention-seconds: 3600
#% endif %#
