#% if cliproxyapi_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: cliproxyapi-secret
stringData:
  # Seeded onto the volume once; the app owns the copy there.
  config.yaml: |
    config-version: 8
    server:
      # Without it the app binds :0 (measured live), not 8317.
      port: 8317
      # The gateway forwards the client address, and the app bans an address after five bad management keys.
      trusted-proxies: ["#{ kubernetes.pod_cidr }#"]
    management:
      allow-remote: true
      secret-key: "#{ cliproxyapi.management_key }#"
      # The manager replaces the bundled panel, which the app would otherwise download from GitHub.
      disable-control-panel: true
    access:
      api-keys:
        - "#{ cliproxyapi.api_key }#"
    oauth:
      auth-dir: /data/auths
    plugins:
      # Off by default upstream, and the manager hides its Plugins page while it is off.
      enabled: true
      # The default "plugins" is under the read-only image root; a store install writes here.
      dir: /data/plugins
    routing:
      # Each login's weight lives in its token file, set in the manager (not in Git).
      strategy: weighted-round-robin
      session-affinity: true
      cooldown:
        # Keeps a throttled login out of rotation across a restart (.cds files in auth-dir).
        save-cooldown-status: true
    upstream:
      claude:
        # A Fable weekly 429 cools only Fable on that login, not every model.
        model-level-cooling: true
    requests:
      # Blank lines keep a long non-streaming answer alive through the gateway's idle timeout.
      nonstream-keepalive-interval: 30
    observability:
      logs:
        logging-to-file: false
      usage:
        # The manager's usage pages read this queue; an hour (the maximum) survives a manager restart.
        usage-statistics-enabled: true
        redis-usage-queue-retention-seconds: 3600
#% endif %#
