#% if cliproxyapi_enabled %#
---
# The gateways, the two consoles and, when it is routed through the proxy, the
# career-ops web pod only. Egress stays open: the proxy dials the providers and its
# version checks on the internet.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cliproxyapi
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cliproxyapi
      app.kubernetes.io/controller: cliproxyapi
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: cpa-manager
        #% if ohmycpa_enabled %#
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: oh-my-cpa
        #% endif %#
        #% if career_ops.anthropic_base_url %#
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: career-ops
          podSelector:
            matchLabels:
              app.kubernetes.io/name: career-ops
              app.kubernetes.io/controller: web
        #% endif %#
      ports:
        - protocol: TCP
          port: 8317
#% endif %#
