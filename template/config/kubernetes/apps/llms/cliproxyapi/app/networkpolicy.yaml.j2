#% if cliproxyapi_enabled %#
---
# The gateways and the manager only. Egress stays open: the proxy dials the
# providers and its version checks on the internet.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cliproxyapi
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cliproxyapi
      app.kubernetes.io/controller: cliproxyapi
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: cpa-manager
      ports:
        - protocol: TCP
          port: 8317
#% endif %#
