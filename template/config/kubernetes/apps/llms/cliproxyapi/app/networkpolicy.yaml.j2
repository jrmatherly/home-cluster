#% if cliproxyapi_enabled %#
---
# The gateways and the two consoles, plus Firecrawl's API pod when it is deployed and
# the career-ops web pod when it is routed through the proxy. Egress stays open: the
# proxy dials the providers and its version checks on the internet.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: cliproxyapi
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: cliproxyapi
      app.kubernetes.io/controller: cliproxyapi
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: cpa-manager
        #% if ohmycpa_enabled %#
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: oh-my-cpa
        #% endif %#
        #% if career_ops.claude_credential == "proxy" %#
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: career-ops
          podSelector:
            matchLabels:
              app.kubernetes.io/name: career-ops
              app.kubernetes.io/controller: web
        #% endif %#
        #% if firecrawl_enabled %#
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: firecrawl
          podSelector:
            matchLabels:
              app.kubernetes.io/name: firecrawl
              app.kubernetes.io/controller: api
        #% endif %#
      ports:
        - protocol: TCP
          port: 8317
#% endif %#
