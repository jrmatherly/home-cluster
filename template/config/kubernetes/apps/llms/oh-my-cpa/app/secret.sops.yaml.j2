#% if ohmycpa_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: oh-my-cpa-secret
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
stringData:
  OMCPA_CPA_MANAGEMENT_KEY: "#{ cliproxyapi.management_key }#"
  OMCPA_MASTER_KEY: "#{ cliproxyapi.ohmycpa_master_key }#"
#% endif %#
