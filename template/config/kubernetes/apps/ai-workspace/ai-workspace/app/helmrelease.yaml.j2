#% if ai_workspace_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: ai-workspace
spec:
  chartRef:
    kind: OCIRepository
    name: ai-workspace
  interval: 1h
  # Helm waits for the migrate hook, which on a first install also waits for
  # the database, longer than helm-controller's default 5m.
  timeout: 15m
  values:
    controllers:
      ai-workspace:
        annotations:
          reloader.stakater.com/auto: "true"
        initContainers:
          wait-for-database: &waitForDatabase
            image:
              repository: docker.io/library/busybox
              tag: "1.38"
            command: ["sh", "-c", "until nc -z -w 2 ai-workspace-db-rw 5432; do sleep 2; done"]
            securityContext: &securityContext
              allowPrivilegeEscalation: false
              readOnlyRootFilesystem: true
              capabilities: { drop: ["ALL"] }
        containers:
          app:
            image: &image
              repository: ghcr.io/jrmatherly/ai-workspace
              tag: latest@sha256:d14b0dd7d60789954e220789255625344c3baeb270ef027c0c2aed777d1a0e17
            env:
              POSTGRES_PRISMA_URL: &databaseUrl
                valueFrom:
                  secretKeyRef:
                    name: ai-workspace-db-app
                    key: uri
              POSTGRES_URL_NON_POOLING: *databaseUrl
              AUTH_URL: https://ai.${SECRET_DOMAIN}
              AUTH_OIDC_ISSUER: https://auth.${SECRET_DOMAIN}
              AUTH_OIDC_CLIENT_ID: "#{ ai_workspace.oidc_client_id }#"
#% if nvidia_enabled %#
              LOCALAI_API_HOST: http://llama-server.ai.svc.cluster.local:8080
#% endif %#
            envFrom:
              - secretRef:
                  name: ai-workspace-secret
            probes:
              # The app has no health route, so the probes ask for a cheap JSON
              # endpoint that needs no input.
              liveness: &probe
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: &probePath /api/trpc/backend.listCapabilities
                    port: &port 3000
                  periodSeconds: 10
                  timeoutSeconds: 5
              readiness: *probe
              startup:
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: *probePath
                    port: *port
                  periodSeconds: 5
                  failureThreshold: 60
            securityContext: *securityContext
            resources:
              requests:
                cpu: 250m
                memory: 256Mi
              limits:
                memory: 1Gi
      # One hook Job, never a step per replica: concurrent migrate runs time out
      # on Prisma's advisory lock (P1002). A failed run fails the release and
      # the old pods keep serving.
      migrate:
        type: job
        annotations:
          helm.sh/hook: pre-install,pre-upgrade
          helm.sh/hook-delete-policy: before-hook-creation
        job:
          backoffLimit: 0
          activeDeadlineSeconds: 840
        initContainers:
          wait-for-database: *waitForDatabase
        containers:
          app:
            image: *image
            command: ["/app/node_modules/.bin/prisma", "migrate", "deploy"]
            env:
              POSTGRES_URL_NON_POOLING: *databaseUrl
            securityContext: *securityContext
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 512Mi
    defaultPodOptions:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        runAsGroup: 1001
        seccompProfile: { type: RuntimeDefault }
    service:
      app:
        controller: ai-workspace
        ports:
          http:
            port: *port
    persistence:
      tmp:
        type: emptyDir
        globalMounts:
          - path: /tmp
      # next/image writes its optimized images here.
      next-cache:
        type: emptyDir
        globalMounts:
          - path: /app/.next/cache
#% endif %#
