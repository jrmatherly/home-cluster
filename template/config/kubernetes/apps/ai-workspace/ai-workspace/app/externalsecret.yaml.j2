#% if ai_workspace_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ai-workspace
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: ai-workspace-secret
    creationPolicy: Owner
    template:
      data:
        AUTH_SECRET: "{{ .AUTH_SECRET }}"
        AUTH_OIDC_CLIENT_SECRET: "{{ .OIDC_CLIENT_SECRET }}"
        #% if nvidia_enabled %#
        LOCALAI_API_KEY: "{{ .LOCALAI_API_KEY }}"
        #% endif %#
        #% if ai_workspace.allowed_emails %#
        # In the vault so the household's addresses stay out of the public repo.
        AUTH_ALLOWED_EMAILS: "{{ .ALLOWED_EMAILS }}"
        #% endif %#
        #% if ai_workspace.admin_emails %#
        AUTH_ADMIN_EMAILS: "{{ .ADMIN_EMAILS }}"
        #% endif %#
        #% if ai_workspace.browsing_token %#
        # Both pods read this Secret, so one rotation restarts both through Reloader.
        BROWSERLESS_TOKEN: "{{ .BROWSING_TOKEN }}"
        PUPPETEER_WSS_ENDPOINT: "ws://browserless.ai-workspace.svc.cluster.local:3000/chromium?token={{ .BROWSING_TOKEN }}"
        #% endif %#
  dataFrom:
    - extract:
        key: ai-workspace
  #% if nvidia_enabled %#
  data:
    - secretKey: LOCALAI_API_KEY
      remoteRef:
        key: localai
        property: API_KEY
  #% endif %#
#% endif %#
