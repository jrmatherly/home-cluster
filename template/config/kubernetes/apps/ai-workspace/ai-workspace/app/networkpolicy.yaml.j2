#% if ai_workspace_enabled %#
---
# The gateway is the only intended path, and the app's sign-in rate limit keys
# on the client address the gateway forwards, so only the gateway may reach it.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ai-workspace
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ai-workspace
      app.kubernetes.io/controller: ai-workspace
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
      ports:
        - protocol: TCP
          port: 3000
#% endif %#
