#% if ai_workspace_enabled and ai_workspace.env %#
---
# Only rendered when the env table has a key: an ExternalSecret with no data is invalid.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ai-workspace-env
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: ai-workspace-env
    creationPolicy: Owner
    template:
      data:
        #% for key in ai_workspace.env | sort %#
        #{ key }#: "{{ .#{ key }# }}"
        #% endfor %#
  dataFrom:
    - extract:
        key: ai-workspace-env
#% endif %#
