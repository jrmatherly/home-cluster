#% if ai_workspace_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: ai-workspace-secret
stringData:
  AUTH_SECRET: "#{ ai_workspace.auth_secret }#"
  AUTH_OIDC_CLIENT_SECRET: "#{ ai_workspace.oidc_client_secret }#"
#% if ai_workspace.allowed_emails %#
  # Encrypted so the household's addresses stay out of the public repo.
  AUTH_ALLOWED_EMAILS: "#{ ai_workspace.allowed_emails | join(',') }#"
#% endif %#
#% if ai_workspace.admin_emails %#
  AUTH_ADMIN_EMAILS: "#{ ai_workspace.admin_emails | join(',') }#"
#% endif %#
#% for key, value in ai_workspace.env | dictsort %#
  #{ key }#: "#{ value }#"
#% endfor %#
#% endif %#
