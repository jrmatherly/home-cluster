#% if ai_workspace_enabled %#
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: ai-workspace-db
spec:
  # Six fields, seconds first: 05:00 UTC every day.
  schedule: "0 0 5 * * *"
  immediate: true
  backupOwnerReference: self
  cluster:
    name: ai-workspace-db
  # A standby cannot close the WAL segment a backup ends in, so on a quiet
  # database the backup is not restorable until the next segment switch.
  target: primary
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
#% endif %#
