#% if etcd_backup_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: etcd-snapshot-backup
stringData:
  ENDPOINT_HOST: "#{ postgres.backup.endpoint | replace('https://', '') }#"
  BUCKET: "#{ etcd_backup.bucket }#"
  ACCESS_KEY: "#{ etcd_backup.access_key }#"
  SECRET_KEY: "#{ etcd_backup.secret_key }#"
#% endif %#
