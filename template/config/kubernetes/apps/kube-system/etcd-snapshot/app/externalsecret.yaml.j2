#% if etcd_backup_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: etcd-snapshot-backup
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: etcd-snapshot-backup
    creationPolicy: Owner
    template:
      data:
        ENDPOINT_HOST: "#{ postgres.backup.endpoint | replace('https://', '') }#"
        BUCKET: "{{ .BUCKET }}"
        ACCESS_KEY: "{{ .ACCESS_KEY }}"
        SECRET_KEY: "{{ .SECRET_KEY }}"
  dataFrom:
    - extract:
        key: etcd-backup
#% endif %#
