#% if etcd_backup_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: etcd-snapshot
spec:
  interval: 1h
  path: ./kubernetes/apps/kube-system/etcd-snapshot/app
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: kube-system
  wait: false
#% endif %#
