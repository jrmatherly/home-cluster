#% if observability_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: grafana
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: grafana-secret
    creationPolicy: Owner
    template:
      data:
        admin-user: admin
        admin-password: "{{ .GRAFANA_PASSWORD }}"
        INFLUXDB_TOKEN: "{{ .INFLUXDB_TOKEN }}"
        #% if observability.grafana_oidc_client_id %#
        OIDC_CLIENT_SECRET: "{{ .GRAFANA_OIDC_CLIENT_SECRET }}"
        #% endif %#
        #% if observability.secret_key %#
        SECRET_KEY: "{{ .GRAFANA_SECRET_KEY }}"
        #% endif %#
        #% if observability.github_app_id %#
        # The PEM ends in exactly one newline, whatever the item holds.
        GITHUB_APP_PRIVATE_KEY: |
          {{ .GITHUB_APP_PRIVATE_KEY | trim }}
        #% endif %#
        #% if observability.sentry_org %#
        SENTRY_TOKEN: "{{ .SENTRY_TOKEN }}"
        #% endif %#
        #% if nvidia_enabled %#
        LOCALAI_API_KEY: "{{ .LOCALAI_API_KEY }}"
        #% endif %#
  dataFrom:
    - extract:
        key: observability
  #% if nvidia_enabled %#
  data:
    - secretKey: LOCALAI_API_KEY
      remoteRef:
        key: localai
        property: API_KEY
  #% endif %#
#% endif %#
