#% if observability_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: kube-prometheus-stack
spec:
  chartRef:
    kind: OCIRepository
    name: kube-prometheus-stack
  interval: 1h
  timeout: 15m
  values:
    # Cilium replaces kube-proxy.
    kubeProxy:
      enabled: false
    # Talos runs etcd as a host service, not a pod, so there is nothing to select.
    kubeEtcd:
      endpoints:
        #% for node in nodes if node.controller %#
        - #{ node.address }#
        #% endfor %#
    kubelet:
      serviceMonitor:
        cAdvisorRelabelings:
          # The chart's default. Its rules and dashboards need it.
          - action: replace
            sourceLabels: [__metrics_path__]
            targetLabel: metrics_path
          # Freelens filters container metrics by instance=<node name> in its cluster view.
          - action: replace
            sourceLabels: [node]
            targetLabel: instance
    prometheus:
      prometheusSpec:
        retention: 14d
        # Memory follows the series count, not retention. The limit is three times
        # the measured peak, because replaying the WAL after a restart needs more
        # than steady state and a limit that is too tight ends in a crash loop.
        resources:
          requests:
            memory: 1Gi
          limits:
            memory: 3Gi
        # Use every monitor and rule in the cluster, not only this release's.
        podMonitorSelectorNilUsesHelmValues: false
        probeSelectorNilUsesHelmValues: false
        ruleSelectorNilUsesHelmValues: false
        scrapeConfigSelectorNilUsesHelmValues: false
        serviceMonitorSelectorNilUsesHelmValues: false
        storageSpec:
          volumeClaimTemplate:
            spec:
              storageClassName: local-path
              accessModes: ["ReadWriteOnce"]
              resources:
                requests:
                  storage: 20Gi
    alertmanager:
      #% if observability.discord_webhook %#
      # Helm merges this over the chart's config, so its grouping and inhibit rules stay.
      config:
        route:
          receiver: discord
          routes:
            # Watchdog always fires, and InfoInhibitor only exists to mute info alerts.
            - receiver: "null"
              matchers:
                - alertname =~ "Watchdog|InfoInhibitor"
        receivers:
          - name: "null"
          - name: discord
            discord_configs:
              - webhook_url_file: /etc/alertmanager/secrets/alertmanager-secret/discord-webhook
      #% endif %#
      alertmanagerSpec:
        #% if observability.discord_webhook %#
        # Mounted at /etc/alertmanager/secrets/alertmanager-secret.
        secrets:
          - alertmanager-secret
        #% endif %#
        storage:
          volumeClaimTemplate:
            spec:
              storageClassName: local-path
              accessModes: ["ReadWriteOnce"]
              resources:
                requests:
                  storage: 1Gi
    grafana:
      admin:
        existingSecret: grafana-secret
      # Grafana reads grafana-secret into its environment only at start.
      annotations:
        reloader.stakater.com/auto: "true"
      resources:
        requests:
          memory: 256Mi
        limits:
          memory: 768Mi
      # The volume is ReadWriteOnce, so the old pod has to stop first.
      deploymentStrategy:
        type: Recreate
      persistence:
        enabled: true
        storageClassName: local-path
        size: 2Gi
      route:
        main:
          enabled: true
          hostnames:
            - "grafana.${SECRET_DOMAIN}"
          parentRefs:
            - name: envoy-internal
              namespace: network
      envValueFrom:
        INFLUXDB_TOKEN:
          secretKeyRef:
            name: grafana-secret
            key: INFLUXDB_TOKEN
        #% if observability.grafana_oidc_client_id %#
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
          secretKeyRef:
            name: grafana-secret
            key: OIDC_CLIENT_SECRET
        #% endif %#
        #% if observability.grafana_secret_key %#
        # From envValueFrom, so it stays out of the grafana.ini ConfigMap like the OAuth secret.
        GF_SECURITY_SECRET_KEY:
          secretKeyRef:
            name: grafana-secret
            key: SECRET_KEY
        #% endif %#
      additionalDataSources:
        - name: InfluxDB
          type: influxdb
          access: proxy
          url: http://influxdb.observability.svc.cluster.local:8086
          jsonData:
            version: Flux
            organization: home
            defaultBucket: proxmox
          secureJsonData:
            # Grafana expands this from its environment. Flux leaves $VAR without braces alone.
            token: $INFLUXDB_TOKEN
      grafana.ini:
        plugins:
          # The image bundles these datasource plugins, and the chart turns their
          # updates off. Listing them installs the catalog's latest at every
          # start, within the same major, onto the persistent volume.
          preinstall: prometheus,influxdb,loki,jaeger,zipkin,mysql,mssql,opentsdb,grafana-postgresql-datasource
          preinstall_auto_update: true
        #% if observability.grafana_oidc_client_id %#
        # The client secret comes from envValueFrom, so it stays out of the grafana.ini ConfigMap.
        server:
          # Without this Grafana builds its OAuth callback from http and port 3000.
          root_url: https://grafana.${SECRET_DOMAIN}
        auth.generic_oauth:
          enabled: true
          name: Pocket ID
          client_id: "#{ observability.grafana_oidc_client_id }#"
          scopes: openid profile email groups
          auth_url: https://auth.${SECRET_DOMAIN}/authorize
          token_url: https://auth.${SECRET_DOMAIN}/api/oidc/token
          api_url: https://auth.${SECRET_DOMAIN}/api/oidc/userinfo
          use_pkce: true
          # Only the Pocket ID group cluster_admins gets a role. Strict mode refuses everyone else.
          role_attribute_path: "contains(groups[*], 'cluster_admins') && 'GrafanaAdmin'"
          role_attribute_strict: true
          allow_assign_grafana_admin: true
        #% endif %#
#% endif %#
