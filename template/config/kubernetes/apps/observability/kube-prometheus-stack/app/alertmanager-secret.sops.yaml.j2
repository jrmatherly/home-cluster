#% if observability.discord_webhook %#
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-secret
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
stringData:
  discord-webhook: "#{ observability.discord_webhook }#"
  #% if observability.heartbeat_url %#
  heartbeat-url: "#{ observability.heartbeat_url }#"
  #% endif %#
#% endif %#
