#% if observability_enabled %#
---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  #% if observability.discord_webhook %#
  - ./alertmanager-secret.sops.yaml
  #% endif %#
  #% if nvidia_enabled %#
  - ./grafana-llm-app.yaml
  #% endif %#
  - ./helmrelease.yaml
  - ./ocirepository.yaml
  - ./secret.sops.yaml
#% if observability.github_app_id or observability.sentry_org %#
configMapGenerator:
  #% if observability.github_app_id %#
  - name: grafana-dashboard-github
    files:
      - dashboards/github.json
    options:
      disableNameSuffixHash: true
      labels:
        grafana_dashboard: "1"
      # The JSON holds Grafana's own ${datasource} and ${__value.raw} expressions, which Flux's
      # variable substitution would otherwise try to expand.
      annotations:
        kustomize.toolkit.fluxcd.io/substitute: disabled
  #% endif %#
  #% if observability.sentry_org %#
  - name: grafana-dashboard-sentry
    files:
      - dashboards/sentry.json
    options:
      disableNameSuffixHash: true
      labels:
        grafana_dashboard: "1"
      # The JSON holds Grafana's own ${datasource} and ${__value.raw} expressions, which Flux's
      # variable substitution would otherwise try to expand.
      annotations:
        kustomize.toolkit.fluxcd.io/substitute: disabled
  #% endif %#
#% endif %#
#% endif %#
