#% if observability.discord_webhook %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: alertmanager
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: alertmanager-secret
    creationPolicy: Owner
    template:
      data:
        discord-webhook: "{{ .DISCORD_WEBHOOK }}"
        #% if observability.heartbeat_url %#
        heartbeat-url: "{{ .HEARTBEAT_URL }}"
        #% endif %#
  dataFrom:
    - extract:
        key: observability
#% endif %#
