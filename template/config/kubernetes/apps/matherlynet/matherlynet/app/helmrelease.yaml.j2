#% if matherlynet_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: matherlynet
spec:
  chartRef:
    kind: OCIRepository
    name: matherlynet
  interval: 1h
  valuesFrom:
    # CloudNativePG generates this Secret. uri is the connection string for the
    # read-write Service.
    - kind: Secret
      name: matherlynet-db-app
      valuesKey: uri
      targetPath: secrets.web.appdb_uri
    - kind: Secret
      name: matherlynet-secret
      valuesKey: values.yaml
  values:
    config:
      web:
        # The site is the domain's apex and accepts auth requests for this
        # origin only.
        app_url: https://${SECRET_DOMAIN}
#% if matherlynet.github_client_id %#
        github_client_id: "#{ matherlynet.github_client_id }#"
#% endif %#
#% if matherlynet.google_client_id %#
        google_client_id: "#{ matherlynet.google_client_id }#"
#% endif %#
#% if matherlynet.playground %#
        # The base URL, without /v1.
        playground_model_url: http://localai.ai.svc.cluster.local:8080
#% endif %#
  # The chart cannot set a securityContext, resources or annotations, and the
  # namespace enforces the restricted pod security level. runAsUser is set
  # because the image's user is a name (node), which the kubelet cannot verify
  # as non-root. The pod reads its config through envFrom, so Reloader restarts
  # it when the ConfigMap or Secret changes. maxUnavailable 0 keeps the one
  # pod serving until its replacement is ready, because the chart's default
  # (maxUnavailable 1 on a single replica) takes the site down on every upgrade.
  # The database URI from the generated -app Secret carries no sslmode and the
  # chart cannot append one, so PGSSLMODE turns TLS on: node-postgres reads it
  # when the URI sets none, and "require" verifies the chain against Node's
  # trust store, which NODE_EXTRA_CA_CERTS extends with the cluster's CA.
  postRenderers:
    - kustomize:
        patches:
          - patch: |
              apiVersion: apps/v1
              kind: Deployment
              metadata:
                name: matherlynet-web-deployment
                annotations:
                  reloader.stakater.com/auto: "true"
              spec:
                strategy:
                  rollingUpdate:
                    maxUnavailable: 0
                template:
                  spec:
                    securityContext:
                      runAsNonRoot: true
                      runAsUser: 1000
                      runAsGroup: 1000
                      seccompProfile: { type: RuntimeDefault }
                    containers:
                      - name: web
                        securityContext:
                          allowPrivilegeEscalation: false
                          readOnlyRootFilesystem: true
                          capabilities: { drop: ["ALL"] }
                        resources:
                          requests: { cpu: 100m, memory: 384Mi }
                          limits: { memory: 768Mi }
                        env:
                          - name: PGSSLMODE
                            value: require
                          - name: NODE_EXTRA_CA_CERTS
                            value: /etc/cnpg/ca.crt
                        volumeMounts:
                          - name: db-ca
                            mountPath: /etc/cnpg
                            readOnly: true
                    volumes:
                      - name: db-ca
                        secret:
                          secretName: matherlynet-db-ca
                          items:
                            - key: ca.crt
                              path: ca.crt
#% endif %#
