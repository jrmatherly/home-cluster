#% if matherlynet_enabled %#
---
# The secrets are a whole values document because Flux splits a targetPath
# value on commas. The two addresses are here to keep them out of Git.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: matherlynet
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: matherlynet-secret
    creationPolicy: Owner
    template:
      data:
        values.yaml: |
          config:
            web:
              admin_email: "{{ .ADMIN_EMAIL }}"
              #% if matherlynet.mail_from %#
              mail_from: "{{ .MAIL_FROM }}"
              #% endif %#
          secrets:
            web:
              better_auth_secret: "{{ .BETTER_AUTH_SECRET }}"
              #% if matherlynet.playground %#
              playground_model_key: "{{ .LOCALAI_API_KEY }}"
              #% endif %#
              #% if matherlynet.smtp_url %#
              smtp_url: "{{ .SMTP_URL }}"
              #% endif %#
              #% if matherlynet.github_client_secret %#
              github_client_secret: "{{ .GITHUB_CLIENT_SECRET }}"
              #% endif %#
              #% if matherlynet.google_client_secret %#
              google_client_secret: "{{ .GOOGLE_CLIENT_SECRET }}"
              #% endif %#
  dataFrom:
    - extract:
        key: matherlynet
  #% if matherlynet.playground %#
  data:
    - secretKey: LOCALAI_API_KEY
      remoteRef:
        key: localai
        property: API_KEY
  #% endif %#
#% endif %#
