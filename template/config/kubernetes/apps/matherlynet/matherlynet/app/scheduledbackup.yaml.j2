#% if matherlynet_enabled %#
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: matherlynet-db
spec:
  # Six fields, seconds first: 03:00 UTC every day.
  schedule: "0 0 3 * * *"
  immediate: true
  backupOwnerReference: self
  cluster:
    name: matherlynet-db
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
#% endif %#
