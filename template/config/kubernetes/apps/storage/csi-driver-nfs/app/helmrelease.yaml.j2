#% if media_enabled %#
---
# Talos runs no rpc.statd, so the media PersistentVolume mounts with nolock.
# Under NFSv4.1 that keeps file locks on the client, which is safe while every
# pod that mounts the share runs on the same node.
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: csi-driver-nfs
spec:
  chart:
    spec:
      chart: csi-driver-nfs
      version: 4.13.5
      sourceRef:
        kind: HelmRepository
        name: csi-driver-nfs
  interval: 1h
  values:
    controller:
      replicas: 1
      # The cluster has no VolumeSnapshot CRDs, so the snapshotter sidecar
      # would only log errors.
      enableSnapshotter: false
    feature:
      # Without it the CSIDriver carries fsGroupPolicy: File, and the kubelet
      # walks the whole share to chown it to the pod's fsGroup before every
      # media pod starts. That walk fails while SABnzbd is writing (a file
      # vanishes under it) and grows with the library, and the export squashes
      # every client to one uid anyway. Omitted, the policy defaults to
      # ReadWriteOnceWithFSTag, which never touches a ReadWriteMany volume.
      enableFSGroupPolicy: false
#% endif %#
