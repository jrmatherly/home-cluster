#% if rustfs_enabled %#
---
#% if rustfs_consumers %#
# Each pair is read from its consumer's own item. The script reads the keys as
# files named <consumer>-access-key and <consumer>-secret-key.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: rustfs-provision
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: rustfs-provision-secret
    creationPolicy: Owner
    template:
      data:
        #% for c in rustfs_consumers %#
        #{ c.name }#-access-key: "{{ .#{ c.name | replace('-', '_') }#_access_key }}"
        #{ c.name }#-secret-key: "{{ .#{ c.name | replace('-', '_') }#_secret_key }}"
        #% endfor %#
  data:
    #% for c in rustfs_consumers %#
    - secretKey: #{ c.name | replace('-', '_') }#_access_key
      remoteRef:
        key: #{ c.name }#
        property: RUSTFS_ACCESS_KEY
    - secretKey: #{ c.name | replace('-', '_') }#_secret_key
      remoteRef:
        key: #{ c.name }#
        property: RUSTFS_SECRET_KEY
    #% endfor %#
#% else %#
# The Job mounts this Secret even with no consumer to provision.
apiVersion: v1
kind: Secret
metadata:
  name: rustfs-provision-secret
#% endif %#
#% endif %#
