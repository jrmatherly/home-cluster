#% if ingress.mode == 'cloudflare-tunnel' %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-tunnel
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: cloudflare-tunnel-secret
    creationPolicy: Owner
    template:
      data:
        # The token cloudflared reads: base64 of compact JSON with the keys in this order, so the
        # bytes match what the tunnel already runs on. %q quotes as JSON does for these values.
        TUNNEL_TOKEN: '{{ printf "{\"a\":%q,\"t\":%q,\"s\":%q}" .ACCOUNT_TAG "#{ ingress.tunnel_id }#" .TUNNEL_SECRET | b64enc }}'
  dataFrom:
    - extract:
        key: cloudflare-tunnel
#% endif %#
