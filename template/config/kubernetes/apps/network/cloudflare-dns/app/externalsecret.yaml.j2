#% if dns.provider == 'cloudflare' and ingress.mode != 'none' %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-dns
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: cloudflare-dns-secret
    creationPolicy: Owner
    template:
      data:
        api-token: "{{ .TOKEN }}"
  dataFrom:
    - extract:
        key: dns
#% endif %#
