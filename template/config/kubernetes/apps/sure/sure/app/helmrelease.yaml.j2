#% if sure_enabled %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: sure
spec:
  chart:
    spec:
      chart: sure
      version: "0.7.5"
      sourceRef:
        kind: HelmRepository
        name: sure
  interval: 1h
  # The migration hook Job waits for the database inside the install, and the
  # first install also waits for the Postgres image and a two-instance cluster.
  timeout: 15m
  # The chart annotates only pod templates, so a rotated Secret would never
  # restart the pods without this.
  postRenderers:
    - kustomize:
        patches:
          - patch: |
              apiVersion: apps/v1
              kind: Deployment
              metadata:
                name: _
                annotations:
                  reloader.stakater.com/auto: "true"
            target:
              kind: Deployment
              name: sure-(web|worker)
  values:
    image:
      repository: ghcr.io/we-promise/sure
      tag: 0.7.5-hotfix.2@sha256:aa46be2d8e3f8b2182261dc05933a64b4a12543dd5f44ad12f08868caac1f997
    cnpg:
      enabled: false
      cluster:
        enabled: false
    redisOperator:
      enabled: false
      # On its own, this decides whether the chart injects a REDIS_URL of its own.
      managed:
        enabled: false
    rails:
      existingSecret: sure-secret
      # The models encrypt their sensitive columns only when these three keys
      # are set explicitly; the keys Sure derives from SECRET_KEY_BASE are ignored.
      encryptionEnv:
        enabled: true
      extraEnvFrom:
        - secretRef:
            name: sure-secret
      extraEnvVars:
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: sure-db-app
              key: uri
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: redis-auth
              key: password
        - name: REDIS_URL
          value: redis://:$(REDIS_PASSWORD)@redis:6379/0
      settings:
        SELF_HOSTED: "true"
        APP_DOMAIN: sure.${SECRET_DOMAIN}
        # Passkeys bind to the RP ID; the registrable domain survives a hostname move.
        WEBAUTHN_RP_ID: ${SECRET_DOMAIN}
        WEBAUTHN_ALLOWED_ORIGINS: https://sure.${SECRET_DOMAIN}
        OIDC_ISSUER: https://auth.${SECRET_DOMAIN}
        OIDC_CLIENT_ID: "#{ sure.oidc_client_id }#"
        OIDC_REDIRECT_URI: https://sure.${SECRET_DOMAIN}/auth/openid_connect/callback
        OIDC_BUTTON_LABEL: Sign in with Pocket ID
        # Pocket ID is the login. The override keeps a local password usable for super admins only.
        AUTH_LOCAL_LOGIN_ENABLED: "false"
        AUTH_LOCAL_ADMIN_OVERRIDE_ENABLED: "true"
        ACTIVE_STORAGE_SERVICE: cloudflare
        CLOUDFLARE_BUCKET: "#{ sure.r2_bucket }#"
    # The chart already runs as uid 1000 with every capability dropped. The root
    # filesystem stays writable, unlike the other apps here: the migration Job
    # shares the containers' securityContext but gets no volume (writableTmp
    # covers only the web and worker pods), and Rails does not load without a
    # writable temporary directory.
    podSecurityContext:
      seccompProfile: { type: RuntimeDefault }
    migrations:
      # Holds the web pod back until the database accepts connections, as the
      # wait-for-database init containers of the other apps do. Only a wait: the
      # chart gives this container no envFrom, so it must not boot Rails, and
      # the hook Job runs the migrations.
      initContainer:
        enabled: true
        args: |
          DB_HOST=$(echo "$DATABASE_URL" | sed 's/.*@//; s/:.*//')
          until pg_isready -h "$DB_HOST" -p 5432; do echo "Waiting for DB..."; sleep 5; done
    web:
      resources:
        requests: { cpu: 250m, memory: 512Mi }
        limits: { memory: 1536Mi }
    worker:
      resources:
        limits: { memory: 1Gi }
#% endif %#
