#% if sure_enabled %#
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: sure-db
spec:
  # Six fields, seconds first: 05:00 UTC every day.
  schedule: "0 0 5 * * *"
  immediate: true
  backupOwnerReference: self
  cluster:
    name: sure-db
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
#% endif %#
