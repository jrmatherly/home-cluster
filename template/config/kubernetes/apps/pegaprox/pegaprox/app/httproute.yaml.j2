#% if pegaprox_enabled %#
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: pegaprox
spec:
  hostnames: ["pegaprox.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
  rules:
    # Behind a proxy the UI dials both console WebSockets on this origin, but
    # separate servers on 5001 and 5002 answer them, not the Flask app on 5000.
    - matches:
        - path:
            type: RegularExpression
            value: ^/api/clusters/[^/]+/vms/[^/]+/[^/]+/[0-9]+/vncwebsocket$
      backendRefs:
        - name: pegaprox
          port: 5001
    - matches:
        - path:
            type: RegularExpression
            value: ^/api/clusters/[^/]+/nodes/[^/]+/shellws$
      backendRefs:
        - name: pegaprox
          port: 5002
    - backendRefs:
        - name: pegaprox
          port: 5000
#% endif %#
