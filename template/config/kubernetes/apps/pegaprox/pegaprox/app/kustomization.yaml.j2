#% if pegaprox_enabled %#
---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  #% if volume_backup_enabled %#
  - ./backup-cronjob.yaml
  - ./backup-secret.sops.yaml
  #% endif %#
  - ./externalsecret.yaml
  - ./helmrelease.yaml
  - ./httproute.yaml
  - ./networkpolicy.yaml
  - ./ocirepository.yaml
#% if pegaprox_metrics %#
  - ./metrics-externalsecret.yaml
configMapGenerator:
  - name: pegaprox-dashboard
    files:
      - dashboards/pegaprox-overview.json
    options:
      disableNameSuffixHash: true
      labels:
        grafana_dashboard: "1"
#% endif %#
#% endif %#
