#% if pegaprox_metrics %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: pegaprox-metrics
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: pegaprox-metrics
    creationPolicy: Owner
    template:
      data:
        token: "{{ .METRICS_TOKEN }}"
  dataFrom:
    - extract:
        key: pegaprox
#% endif %#
