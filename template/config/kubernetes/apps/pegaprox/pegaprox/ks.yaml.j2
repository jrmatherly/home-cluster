#% if pegaprox_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: pegaprox
spec:
  interval: 1h
  path: ./kubernetes/apps/pegaprox/pegaprox/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: pegaprox
  wait: false
#% endif %#
