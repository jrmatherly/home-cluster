---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: postgres-backup
spec:
  groups:
    - name: postgres-backup
      rules:
        # Every instance reports the same backup timestamps, so take one per cluster.
        - alert: PostgresBackupFailed
          expr: |
            max by (namespace, cnpg_io_cluster) (barman_cloud_cloudnative_pg_io_last_failed_backup_timestamp)
              > max by (namespace, cnpg_io_cluster) (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp)
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: The last backup of {{ $labels.cnpg_io_cluster }} failed
            description: >-
              The most recent backup of Postgres cluster {{ $labels.cnpg_io_cluster }} in
              {{ $labels.namespace }} failed, and no backup has succeeded since.
        # A failure before anything reaches the object store may not be recorded as a
        # failed backup, so also alert on age. Backups run daily. A new cluster reports
        # 0 until its first backup lands. Its ScheduledBackup sets `immediate: true`, so
        # that takes about a minute, and `for` rides it out.
        - alert: PostgresBackupTooOld
          expr: |
            time() - max by (namespace, cnpg_io_cluster) (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp)
              > 36 * 3600
          for: 15m
          labels:
            severity: critical
          annotations:
            summary: No recent backup of {{ $labels.cnpg_io_cluster }}
            description: >-
              Postgres cluster {{ $labels.cnpg_io_cluster }} in {{ $labels.namespace }} has no
              successful backup in the last 36 hours.
        # From CloudNativePG's sample rules. Only the primary archives WAL.
        - alert: PostgresWalArchivingFailing
          expr: |
            (cnpg_pg_stat_archiver_last_failed_time - cnpg_pg_stat_archiver_last_archived_time) > 1
              and on (namespace, pod) cnpg_pg_replication_in_recovery == 0
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: WAL archiving is failing on {{ $labels.pod }}
            description: >-
              Postgres instance {{ $labels.pod }} in {{ $labels.namespace }} cannot archive WAL,
              so point-in-time recovery is falling behind.
        # A cluster that is up but reports no backup metric is a broken PodMonitor or plugin,
        # which the age rule cannot see. radar-db has no backup by design. When every instance
        # of a cluster is down both sides are absent, and KubePodNotReady is the alert for that.
        - alert: PostgresBackupMetricMissing
          expr: |
            count by (namespace, cnpg_io_cluster) (cnpg_collector_up{cnpg_io_cluster!="radar-db"})
              unless count by (namespace, cnpg_io_cluster) (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp)
          for: 2h
          labels:
            severity: critical
          annotations:
            summary: Postgres cluster {{ $labels.cnpg_io_cluster }} reports no backup metric
            description: >-
              Postgres cluster {{ $labels.cnpg_io_cluster }} in {{ $labels.namespace }} is up but
              has reported no backup timestamp for two hours, so the backup alerts cannot see it.
              Check the barman-cloud plugin and the postgres PodMonitor.
        # Every instance read 0 on 2026-10-31, so five minutes held for 15 is past any burst.
        - alert: PostgresReplicaLagging
          expr: cnpg_pg_replication_lag > 300
          for: 15m
          labels:
            severity: warning
          annotations:
            summary: Replica {{ $labels.pod }} is over five minutes behind
            description: >-
              Postgres replica {{ $labels.pod }} of {{ $labels.cnpg_io_cluster }} in
              {{ $labels.namespace }} has lagged by over 300 seconds for 15 minutes.
        # Reads instance count; an instance that is up but not streaming is the lag rule's case.
        # ai-kb-db is one instance by design.
        - alert: PostgresClusterDegraded
          expr: |
            count by (namespace, cnpg_io_cluster) (cnpg_collector_up{cnpg_io_cluster!="ai-kb-db"} == 1) < 2
          for: 15m
          labels:
            severity: warning
          annotations:
            summary: Postgres cluster {{ $labels.cnpg_io_cluster }} has one instance up
            description: >-
              Postgres cluster {{ $labels.cnpg_io_cluster }} in {{ $labels.namespace }} has had
              fewer than two instances reporting up for 15 minutes, so it has no replica to fail
              over to.
