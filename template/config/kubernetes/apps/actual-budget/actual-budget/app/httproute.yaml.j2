#% if actual_budget_enabled %#
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: actual-budget
spec:
  hostnames: ["budget.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
#% if actual_budget.public %#
    - name: envoy-external
      namespace: network
      sectionName: https
#% endif %#
  rules:
    - backendRefs:
        - name: actual-budget
          port: 5006
#% endif %#
