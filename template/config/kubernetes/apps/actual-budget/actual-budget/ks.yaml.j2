#% if actual_budget_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: actual-budget
spec:
  interval: 1h
  path: ./kubernetes/apps/actual-budget/actual-budget/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: actual-budget
  wait: false
#% endif %#
