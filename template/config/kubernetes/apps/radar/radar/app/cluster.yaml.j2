#% if radar_enabled %#
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: radar-db
spec:
  # Radar does not start without its database, and each instance is pinned to a
  # node by its local-path volume, so a second one keeps Radar up when a node is
  # down. The timeline is seven days of history, so it is not backed up.
  instances: 2
  # Peak working set 245 MiB over 7 days, read 2026-11-01. Request at the peak,
  # limit at three times it and 512Mi at least.
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      memory: 768Mi
  # Switch the primary over to the replica on a roll, instead of a restart in place
  # that refuses connections for up to the 180 s smart shutdown.
  primaryUpdateMethod: switchover
  # Counts schedulable nodes, because instance pods do not tolerate the control plane taint.
  affinity:
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: #{ 'required' if nodes | rejectattr('controller') | list | length > 1 else 'preferred' }#
  imageCatalogRef:
    apiGroup: postgresql.cnpg.io
    kind: ImageCatalog
    name: postgresql
    major: 18
  storage:
    storageClass: local-path
    size: 5Gi
#% endif %#
