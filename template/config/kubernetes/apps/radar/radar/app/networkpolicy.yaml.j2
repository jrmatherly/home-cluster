#% if radar_enabled %#
---
# The pod is cluster-admin-equivalent, so only the gateway reaches it. radar-db
# is covered by the postgres component's policy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: radar
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: radar
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
      ports:
        - protocol: TCP
          port: 9280
#% endif %#
