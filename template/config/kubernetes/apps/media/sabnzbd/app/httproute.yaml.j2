#% if media_enabled %#
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: sabnzbd
spec:
  hostnames: ["sabnzbd.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
#% if media.public %#
    - name: envoy-external
      namespace: network
      sectionName: https
#% endif %#
  rules:
    - backendRefs:
        - name: sabnzbd
          port: 8080
---
# The API key is the credential on /api, as upstream, so a mobile client on the
# LAN works without the Pocket ID sign-in. This route stays off envoy-external,
# because an API key alone on the internet is what CVE-2026-30975 punished.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: sabnzbd-api
spec:
  hostnames: ["sabnzbd.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
  rules:
    - matches:
        - path: { type: PathPrefix, value: /api }
        - path: { type: PathPrefix, value: /sabnzbd/api }
      backendRefs:
        - name: sabnzbd
          port: 8080
#% endif %#
