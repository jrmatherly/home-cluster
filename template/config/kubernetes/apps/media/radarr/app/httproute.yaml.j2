#% if media_enabled %#
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: radarr
  labels:
    media.sign-in: pocket-id
spec:
  hostnames: ["radarr.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
#% if media.public %#
    - name: envoy-external
      namespace: network
      sectionName: https
#% endif %#
  rules:
    - backendRefs:
        - name: radarr
          port: 7878
---
# The API key is the credential on /api, as upstream, so a mobile client on the
# LAN works without the Pocket ID sign-in. This route stays off envoy-external,
# because an API key alone on the internet is what CVE-2026-30975 punished.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: radarr-api
spec:
  hostnames: ["radarr.${SECRET_DOMAIN}"]
  parentRefs:
    - name: envoy-internal
      namespace: network
      sectionName: https
  rules:
    - matches:
        - path: { type: PathPrefix, value: /api }
      backendRefs:
        - name: radarr
          port: 7878
#% endif %#
