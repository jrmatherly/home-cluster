#% if media_enabled %#
---
# The arrs run with External auth, so each trusts whoever reaches it. One policy
# for the namespace admits only the gateways and the stack's own pods, so an app
# cannot be added without it.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: media
spec:
  podSelector: {}
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: network
        - podSelector: {}
#% endif %#
