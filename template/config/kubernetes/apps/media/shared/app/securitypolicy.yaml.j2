#% if media_enabled %#
---
# The arrs trust whoever reaches them, so the gateway signs users in with
# Pocket ID. One policy covers every UI route that carries the label below; the
# /api routes, and Seerr with its own login, leave it off. Without redirectURL
# the gateway sends each route's own /oauth2/callback, which the Pocket ID client
# lists per app.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: media
spec:
  targetSelectors:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      matchLabels:
        media.sign-in: pocket-id
  oidc:
    # Set explicitly so the policy does not depend on Pocket ID answering its
    # discovery document when the gateway reconciles.
    provider:
      issuer: https://auth.${SECRET_DOMAIN}
      authorizationEndpoint: https://auth.${SECRET_DOMAIN}/authorize
      tokenEndpoint: https://auth.${SECRET_DOMAIN}/api/oidc/token
    clientID: "#{ media.oidc_client_id }#"
    clientSecret:
      name: media-oidc
    logoutPath: /logout
    scopes: ["openid", "profile", "email", "groups"]
    # A fixed name, so the JWT provider below can read the ID token.
    cookieNames:
      idToken: media-id-token
  # Claim checks need a verified token from a JWT provider in the same policy.
  jwt:
    providers:
      - name: pocket-id
        issuer: https://auth.${SECRET_DOMAIN}
        remoteJWKS:
          uri: https://auth.${SECRET_DOMAIN}/.well-known/jwks.json
        extractFrom:
          cookies: ["media-id-token"]
  authorization:
    defaultAction: Deny
    rules:
      - name: cluster-admins
        action: Allow
        principal:
          jwt:
            provider: pocket-id
            claims:
              - name: groups
                valueType: StringArray
                values: ["cluster_admins"]
#% endif %#
