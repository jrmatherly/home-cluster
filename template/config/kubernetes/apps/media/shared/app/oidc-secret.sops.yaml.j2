#% if media_enabled %#
---
# Every SecurityPolicy in the namespace uses this secret: one Pocket ID client
# carries one callback URL per app.
apiVersion: v1
kind: Secret
metadata:
  name: media-oidc
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
stringData:
  client-secret: "#{ media.oidc_client_secret }#"
#% endif %#
