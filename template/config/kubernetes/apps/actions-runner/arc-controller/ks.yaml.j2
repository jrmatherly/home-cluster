#% if github_runner_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: arc-controller
spec:
  interval: 1h
  path: ./kubernetes/apps/actions-runner/arc-controller/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: actions-runner
  # home-cluster-runners creates an AutoscalingRunnerSet, a CRD this chart installs.
  wait: true
#% endif %#
