#% if firecrawl_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: firecrawl
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: firecrawl-secret
    creationPolicy: Owner
    template:
      data:
        POSTGRES_PASSWORD: "{{ .POSTGRES_PASSWORD }}"
        # CLIProxyAPI's client key, which the API sends as its model provider key.
        OPENAI_API_KEY: "{{ .OPENAI_API_KEY }}"
  dataFrom:
    - extract:
        key: firecrawl
  data:
    - secretKey: OPENAI_API_KEY
      remoteRef:
        key: cliproxyapi
        property: API_KEY
#% endif %#
