#% if firecrawl_enabled %#
---
# Firecrawl has no login of its own, so the gateway asks for a key. Clients send
# `Authorization: Bearer <key>`, as the Firecrawl SDKs, CLI and MCP server do. A call
# to the Service does not pass through here.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: firecrawl
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: firecrawl
  apiKeyAuth:
    credentialRefs:
      - group: ""
        kind: Secret
        name: firecrawl-gateway-keys
    extractFrom:
      - headers: ["Authorization"]
#% endif %#
