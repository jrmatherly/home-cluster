#% if career_ops_enabled %#
---
# The dashboard has no login of its own, so the gateway signs users in with
# Pocket ID and admits only cluster_admins.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: SecurityPolicy
metadata:
  name: career-ops
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: career-ops
  oidc:
    # Set explicitly so the policy does not depend on Pocket ID answering its
    # discovery document when the gateway reconciles.
    provider:
      issuer: https://auth.${SECRET_DOMAIN}
      authorizationEndpoint: https://auth.${SECRET_DOMAIN}/authorize
      tokenEndpoint: https://auth.${SECRET_DOMAIN}/api/oidc/token
    clientID: "#{ career_ops.oidc_client_id }#"
    clientSecret:
      name: career-ops-oidc
    logoutPath: /logout
    scopes: ["openid", "profile", "email", "groups"]
    # A fixed name, so the JWT provider below can read the ID token.
    cookieNames:
      idToken: career-ops-id-token
  # Claim checks need a verified token from a JWT provider in the same policy.
  jwt:
    providers:
      - name: pocket-id
        issuer: https://auth.${SECRET_DOMAIN}
        # Without this, an ID token Pocket ID minted for any other app passes as the cookie.
        audiences: ["#{ career_ops.oidc_client_id }#"]
        remoteJWKS:
          uri: https://auth.${SECRET_DOMAIN}/.well-known/jwks.json
        extractFrom:
          cookies: ["career-ops-id-token"]
  authorization:
    defaultAction: Deny
    rules:
      - name: cluster-admins
        action: Allow
        principal:
          jwt:
            provider: pocket-id
            claims:
              - name: groups
                valueType: StringArray
                values: ["cluster_admins"]
#% endif %#
