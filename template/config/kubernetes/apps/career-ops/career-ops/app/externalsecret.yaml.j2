#% if career_ops_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: career-ops
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: career-ops-secret
    creationPolicy: Owner
    template:
      data:
        #% if career_ops.claude_oauth_token %#
        CLAUDE_CODE_OAUTH_TOKEN: "{{ .CLAUDE_OAUTH_TOKEN }}"
        #% endif %#
        #% if career_ops.anthropic_base_url %#
        ANTHROPIC_AUTH_TOKEN: "{{ .ANTHROPIC_AUTH_TOKEN }}"
        #% endif %#
        #% if career_ops.publish_api_key %#
        PUBLISH_API_KEY: "{{ .PUBLISH_API_KEY }}"
        #% endif %#
  dataFrom:
    - extract:
        key: career-ops
#% endif %#
