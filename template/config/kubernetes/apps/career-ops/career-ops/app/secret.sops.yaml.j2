#% if career_ops_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: career-ops-secret
stringData:
  #% if career_ops.claude_oauth_token %#
  CLAUDE_CODE_OAUTH_TOKEN: "#{ career_ops.claude_oauth_token }#"
  #% endif %#
  #% if career_ops.anthropic_base_url %#
  ANTHROPIC_AUTH_TOKEN: "#{ career_ops.anthropic_auth_token }#"
  #% endif %#
  #% if career_ops.publish_api_key %#
  PUBLISH_API_KEY: "#{ career_ops.publish_api_key }#"
  #% endif %#
#% endif %#
