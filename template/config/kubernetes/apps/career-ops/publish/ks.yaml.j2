#% if career_ops_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: publish
spec:
  interval: 1h
  path: ./kubernetes/apps/career-ops/publish/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: career-ops
  wait: false
#% endif %#
