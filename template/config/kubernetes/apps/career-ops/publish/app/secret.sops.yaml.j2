#% if career_ops_enabled %#
---
apiVersion: v1
kind: Secret
metadata:
  name: publish-secret
stringData:
  PUBLISH_SECRET: "#{ career_ops.publish_secret }#"
  PUBLISH_AUTH_SECRET: "#{ career_ops.publish_auth_secret }#"
  POCKET_ID_CLIENT_SECRET: "#{ career_ops.publish_oidc_client_secret }#"
  # Here, not in the HelmRelease, so no address at the domain is committed in clear.
  PUBLISH_ALLOWED_EMAILS: "#{ career_ops.publish_allowed_emails | join(',') }#"
#% endif %#
