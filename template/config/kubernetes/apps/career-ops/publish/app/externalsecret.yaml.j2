#% if career_ops_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: publish
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: publish-secret
    creationPolicy: Owner
    template:
      data:
        PUBLISH_SECRET: "{{ .PUBLISH_SECRET }}"
        PUBLISH_AUTH_SECRET: "{{ .PUBLISH_AUTH_SECRET }}"
        POCKET_ID_CLIENT_SECRET: "{{ .PUBLISH_OIDC_CLIENT_SECRET }}"
        # Here, not in the HelmRelease, so no address at the domain is committed in clear.
        PUBLISH_ALLOWED_EMAILS: "{{ .PUBLISH_ALLOWED_EMAILS }}"
  dataFrom:
    - extract:
        key: career-ops
#% endif %#
