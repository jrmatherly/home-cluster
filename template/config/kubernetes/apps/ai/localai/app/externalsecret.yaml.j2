#% if nvidia_enabled %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: localai
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: localai-secret
    creationPolicy: Owner
    template:
      data:
        LOCALAI_API_KEY: "{{ .API_KEY }}"
  dataFrom:
    - extract:
        key: localai
#% endif %#
