#% if ai_kb_searxng %#
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: searxng
spec:
  chartRef:
    kind: OCIRepository
    name: searxng
  interval: 1h
  values:
    controllers:
      searxng:
        annotations:
          reloader.stakater.com/auto: "true"
        containers:
          app:
            image:
              repository: docker.io/searxng/searxng
              tag: 2026.10.24-ef0ec03da@sha256:7c7cbe509429e82755104b2a95f52085a98633c95d53f44e4e905fa3a59f08c8
            envFrom:
              - secretRef:
                  name: searxng-secret
            probes:
              liveness: &probe
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: /healthz
                    port: &port 8080
                  periodSeconds: 10
                  timeoutSeconds: 5
              readiness: *probe
              startup:
                enabled: true
                custom: true
                spec:
                  httpGet:
                    path: /healthz
                    port: *port
                  periodSeconds: 5
                  timeoutSeconds: 5
                  failureThreshold: 30
            securityContext:
              allowPrivilegeEscalation: false
              readOnlyRootFilesystem: true
              capabilities: { drop: ["ALL"] }
            resources:
              requests:
                cpu: 50m
                memory: 192Mi
              limits:
                memory: 1Gi
    defaultPodOptions:
      # The Service named searxng would inject SEARXNG_PORT=tcp://..., which the
      # entrypoint drops, but the env stays clean without it.
      enableServiceLinks: false
      # The image's user is the name searxng, which restricted cannot check. As
      # non-root the entrypoint skips its chown and only warns.
      securityContext:
        runAsNonRoot: true
        runAsUser: 977
        runAsGroup: 977
        fsGroup: 977
        seccompProfile: { type: RuntimeDefault }
    service:
      app:
        ports:
          http:
            port: *port
    persistence:
      # By subPath, so /etc/searxng stays the image's directory, which the
      # entrypoint checks; it writes settings.yml only when none exists.
      settings:
        type: configMap
        name: searxng-settings
        globalMounts:
          - path: /etc/searxng/settings.yml
            subPath: settings.yml
            readOnly: true
      # The entrypoint checks that the data directory exists.
      cache:
        type: emptyDir
        globalMounts:
          - path: /var/cache/searxng
      # The engine and data caches are SQLite files in the temp directory.
      tmp:
        type: emptyDir
        globalMounts:
          - path: /tmp
#% endif %#
