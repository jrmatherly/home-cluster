#% if ai_kb_searxng %#
---
# Only the AI KB app pod queries it, and it reaches public search engines only.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: searxng
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: searxng
  policyTypes: ["Ingress", "Egress"]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/component: app
      ports:
        - protocol: TCP
          port: 8080
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
#% for cidr in private_cidrs %#
              - #{ cidr }#
#% endfor %#
      ports:
        - protocol: TCP
          port: 80
        - protocol: TCP
          port: 443
#% endif %#
