#% if ai_kb_enabled %#
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: ai-kb
spec:
  dependsOn:
    - name: cloudnative-pg
      namespace: cnpg-system
    - name: plugin-barman-cloud
      namespace: cnpg-system
    #% if ai_kb_rustfs %#
    # The app checks its bucket at startup, so the key pair has to exist first.
    - name: rustfs-provision
      namespace: rustfs
    #% endif %#
  interval: 1h
  path: ./kubernetes/apps/ai-kb/ai-kb/app
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: ai-kb
  wait: false
#% endif %#
