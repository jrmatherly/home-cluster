#% if ai_kb_enabled %#
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: ai-kb-db-app
spec:
  cluster:
    name: ai-kb-db
  name: app
  owner: app
  ensure: present
  # The app's migrations create these four, and only a superuser (the operator)
  # can create the ones that are not trusted.
  extensions:
    - name: uuid-ossp
    - name: vector
    - name: pg_trgm
    - name: pg_search
#% endif %#
