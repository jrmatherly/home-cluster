#% if ai_kb_enabled %#
---
# values.yaml is a whole values document, because Flux splits a targetPath value on commas.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ai-kb
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: ai-kb-secret
    creationPolicy: Owner
    template:
      data:
        values.yaml: |
          secrets:
            jwtSecret: "{{ .JWT_SECRET }}"
            systemAesKey: "{{ .AES_KEY }}"
          #% if ai_kb_neo4j %#
          neo4j:
            password: "{{ .NEO4J_PASSWORD }}"
          #% endif %#
        #% if ai_kb_oidc %#
        OIDC_AUTH_CLIENT_SECRET: "{{ .OIDC_CLIENT_SECRET }}"
        #% endif %#
        #% if nvidia_enabled %#
        LOCALAI_API_KEY: "{{ .LOCALAI_API_KEY }}"
        #% endif %#
        #% if ai_kb_rustfs %#
        S3_ACCESS_KEY: "{{ .RUSTFS_ACCESS_KEY }}"
        S3_SECRET_KEY: "{{ .RUSTFS_SECRET_KEY }}"
        #% endif %#
        #% if ai_kb_tracing %#
        LANGFUSE_PUBLIC_KEY: "{{ .LANGFUSE_PUBLIC_KEY }}"
        LANGFUSE_SECRET_KEY: "{{ .LANGFUSE_SECRET_KEY }}"
        #% endif %#
  dataFrom:
    - extract:
        key: ai-kb
  #% if nvidia_enabled or ai_kb_tracing %#
  data:
    #% if nvidia_enabled %#
    - secretKey: LOCALAI_API_KEY
      remoteRef:
        key: localai
        property: API_KEY
    #% endif %#
    #% if ai_kb_tracing %#
    - secretKey: LANGFUSE_PUBLIC_KEY
      remoteRef:
        key: langfuse
        property: PUBLIC_KEY
    - secretKey: LANGFUSE_SECRET_KEY
      remoteRef:
        key: langfuse
        property: SECRET_KEY
    #% endif %#
  #% endif %#
#% endif %#
