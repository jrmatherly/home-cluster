#% if ai_kb_enabled %#
---
# A whole values document, because Flux splits a targetPath value on commas.
apiVersion: v1
kind: Secret
metadata:
  name: ai-kb-secret
stringData:
  values.yaml: |
    secrets:
      jwtSecret: "#{ ai_kb.jwt_secret }#"
      systemAesKey: "#{ ai_kb.aes_key }#"
  #% if ai_kb_oidc %#
  OIDC_AUTH_CLIENT_SECRET: "#{ ai_kb.oidc_client_secret }#"
  #% endif %#
  #% if nvidia_enabled %#
  LOCALAI_API_KEY: "#{ localai.api_key }#"
  #% endif %#
#% endif %#
