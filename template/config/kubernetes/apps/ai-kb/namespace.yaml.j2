#% if ai_kb_enabled %#
---
apiVersion: v1
kind: Namespace
metadata:
  name: ai-kb
  labels:
    pod-security.kubernetes.io/enforce: restricted
    #% if nvidia_enabled %#
    localai.ai/client: "true"
    #% endif %#
    #% if ai_kb_rustfs %#
    rustfs.storage/client: "true"
    #% endif %#
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
#% endif %#
