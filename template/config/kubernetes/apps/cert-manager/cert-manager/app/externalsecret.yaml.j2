#% if dns.provider == 'cloudflare' %#
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cert-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: cert-manager-secret
    creationPolicy: Owner
    template:
      data:
        api-token: "{{ .TOKEN }}"
  dataFrom:
    - extract:
        key: dns
#% endif %#
