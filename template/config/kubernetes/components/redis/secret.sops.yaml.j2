#% if redis_enabled %#
---
# The server reads redis.conf, so the password is never in its arguments.
apiVersion: v1
kind: Secret
metadata:
  name: redis-auth
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
stringData:
  password: "#{ redis.password }#"
  redis.conf: "requirepass #{ redis.password }#"
#% endif %#
