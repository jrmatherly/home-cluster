#% if redis_enabled %#
---
# The server reads redis.conf, so the password is never in its arguments.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: redis-auth
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: onepassword-connect
  target:
    name: redis-auth
    creationPolicy: Owner
    template:
      data:
        password: "{{ .PASSWORD }}"
        redis.conf: "requirepass {{ .PASSWORD }}"
  dataFrom:
    - extract:
        key: redis
#% endif %#
