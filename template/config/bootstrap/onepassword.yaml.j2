#% if onepassword_enabled %#
---
# References only, no values: `op inject` fills them at bootstrap. It pastes
# raw text, so each reference sits alone in a block scalar.
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-credentials
  namespace: external-secrets
stringData:
  1password-credentials.json: |-
    op://#{ onepassword.vault }#/1password/OP_CREDENTIALS_JSON
---
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-token
  namespace: external-secrets
stringData:
  token: |-
    op://#{ onepassword.vault }#/1password/OP_CONNECT_TOKEN
---
# The flux-system Kustomizations substitute the domain before External Secrets runs.
apiVersion: v1
kind: Secret
metadata:
  name: cluster-secrets
  namespace: flux-system
stringData:
  SECRET_DOMAIN: |-
    op://#{ onepassword.vault }#/cluster/SECRET_DOMAIN
#% endif %#
