{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActualBudget": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        }
      },
      "title": "ActualBudget",
      "type": "object"
    },
    "AiKb": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "admin_email": {
          "$ref": "#/$defs/EmailAddress",
          "default": ""
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "rustfs": {
          "default": false,
          "title": "Rustfs",
          "type": "boolean"
        },
        "tracing": {
          "default": false,
          "title": "Tracing",
          "type": "boolean"
        },
        "neo4j": {
          "default": false,
          "title": "Neo4J",
          "type": "boolean"
        },
        "searxng": {
          "default": false,
          "title": "Searxng",
          "type": "boolean"
        }
      },
      "title": "AiKb",
      "type": "object"
    },
    "AiWorkspace": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "allowlist": {
          "default": false,
          "title": "Allowlist",
          "type": "boolean"
        },
        "admins": {
          "default": false,
          "title": "Admins",
          "type": "boolean"
        },
        "browsing": {
          "default": false,
          "title": "Browsing",
          "type": "boolean"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        },
        "env_keys": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Env Keys",
          "type": "array"
        }
      },
      "title": "AiWorkspace",
      "type": "object"
    },
    "Api": {
      "additionalProperties": false,
      "properties": {
        "addr": {
          "format": "ipv4",
          "title": "Addr",
          "type": "string"
        },
        "tls_sans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Fqdn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls Sans"
        }
      },
      "required": ["addr"],
      "title": "Api",
      "type": "object"
    },
    "Asn": {
      "type": "string"
    },
    "Bgp": {
      "additionalProperties": false,
      "properties": {
        "router_addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Router Addr"
        },
        "router_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        },
        "node_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        }
      },
      "title": "Bgp",
      "type": "object"
    },
    "CareerOps": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "claude_credential": {
          "default": "oauth",
          "enum": ["oauth", "proxy"],
          "title": "Claude Credential",
          "type": "string"
        },
        "anthropic_base_url": {
          "default": "",
          "pattern": "^(https?://\\S*[^/\\s])?$",
          "title": "Anthropic Base Url",
          "type": "string"
        },
        "publish_oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Publish Oidc Client Id",
          "type": "string"
        },
        "publish": {
          "default": false,
          "title": "Publish",
          "type": "boolean"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        }
      },
      "title": "CareerOps",
      "type": "object"
    },
    "Cidr": {
      "format": "ipv4network",
      "type": "string"
    },
    "Cilium": {
      "additionalProperties": false,
      "properties": {
        "loadbalancer_mode": {
          "default": "dsr",
          "enum": ["dsr", "snat"],
          "title": "Loadbalancer Mode",
          "type": "string"
        },
        "bgp": {
          "$ref": "#/$defs/Bgp",
          "default": {
            "router_addr": "",
            "router_asn": "",
            "node_asn": ""
          }
        },
        "hubble": {
          "$ref": "#/$defs/Hubble",
          "default": {
            "oidc_client_id": ""
          }
        }
      },
      "title": "Cilium",
      "type": "object"
    },
    "CliProxyApi": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "ohmycpa": {
          "default": false,
          "title": "Ohmycpa",
          "type": "boolean"
        },
        "github": {
          "default": false,
          "title": "Github",
          "type": "boolean"
        }
      },
      "title": "CliProxyApi",
      "type": "object"
    },
    "Dns": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "cloudflare",
          "enum": ["cloudflare", "none"],
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "Dns",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Fqdn"
        }
      },
      "required": ["name"],
      "title": "Domain",
      "type": "object"
    },
    "EmailAddress": {
      "pattern": "^[^\\s\"\\\\$,@]+@[^\\s\"\\\\$,@]+\\.[^\\s\"\\\\$,@]+$",
      "type": "string"
    },
    "EtcdBackup": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "EtcdBackup",
      "type": "object"
    },
    "Fqdn": {
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
      "type": "string"
    },
    "Gateways": {
      "additionalProperties": false,
      "properties": {
        "internal": {
          "format": "ipv4",
          "title": "Internal",
          "type": "string"
        },
        "dns": {
          "format": "ipv4",
          "title": "Dns",
          "type": "string"
        },
        "external": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External"
        }
      },
      "required": ["internal", "dns"],
      "title": "Gateways",
      "type": "object"
    },
    "GithubRunner": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "GithubRunner",
      "type": "object"
    },
    "Hubble": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        }
      },
      "title": "Hubble",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "cloudflare-tunnel",
          "enum": ["cloudflare-tunnel", "direct", "none"],
          "title": "Mode",
          "type": "string"
        },
        "tunnel_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9-]*$",
          "title": "Tunnel Id",
          "type": "string"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "Itsaplan": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "Itsaplan",
      "type": "object"
    },
    "Kener": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "smtp": {
          "default": false,
          "title": "Smtp",
          "type": "boolean"
        }
      },
      "title": "Kener",
      "type": "object"
    },
    "Kubernetes": {
      "additionalProperties": false,
      "properties": {
        "pod_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.42.0.0/16"
        },
        "svc_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.43.0.0/16"
        },
        "coredns_addr": {
          "format": "ipv4",
          "title": "Coredns Addr",
          "type": "string"
        },
        "api": {
          "$ref": "#/$defs/Api"
        }
      },
      "required": ["api"],
      "title": "Kubernetes",
      "type": "object"
    },
    "Langfuse": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        }
      },
      "title": "Langfuse",
      "type": "object"
    },
    "LocalAi": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        }
      },
      "title": "LocalAi",
      "type": "object"
    },
    "Matherlynet": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "smtp": {
          "default": false,
          "title": "Smtp",
          "type": "boolean"
        },
        "mail": {
          "default": false,
          "title": "Mail",
          "type": "boolean"
        },
        "github_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Github Client Id",
          "type": "string"
        },
        "github": {
          "default": false,
          "title": "Github",
          "type": "boolean"
        },
        "google_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Google Client Id",
          "type": "string"
        },
        "google": {
          "default": false,
          "title": "Google",
          "type": "boolean"
        },
        "playground": {
          "default": false,
          "title": "Playground",
          "type": "boolean"
        }
      },
      "title": "Matherlynet",
      "type": "object"
    },
    "Media": {
      "additionalProperties": false,
      "properties": {
        "nfs_server": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Nfs Server"
        },
        "nfs_share": {
          "default": "/srv/media",
          "pattern": "^/[^\"\\\\\\s$]*$",
          "title": "Nfs Share",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/WorkerName",
          "default": ""
        },
        "timezone": {
          "default": "Etc/UTC",
          "pattern": "^[A-Za-z0-9_+/-]+$",
          "title": "Timezone",
          "type": "string"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "recyclarr": {
          "default": false,
          "title": "Recyclarr",
          "type": "boolean"
        },
        "plex_host": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Plex Host"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        },
        "keys_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Keys Revision",
          "type": "integer"
        }
      },
      "title": "Media",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "node_cidr": {
          "$ref": "#/$defs/Cidr"
        },
        "dns_servers": {
          "default": ["1.1.1.1", "1.0.0.1"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Dns Servers",
          "type": "array"
        },
        "ntp_servers": {
          "default": ["162.159.200.1", "162.159.200.123"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Ntp Servers",
          "type": "array"
        },
        "default_gateway": {
          "format": "ipv4",
          "title": "Default Gateway",
          "type": "string"
        },
        "vlan_tag": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlan Tag"
        }
      },
      "required": ["node_cidr"],
      "title": "Network",
      "type": "object"
    },
    "NetworkOptimizer": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        }
      },
      "title": "NetworkOptimizer",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$|^[a-z0-9]$",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "format": "ipv4",
          "title": "Address",
          "type": "string"
        },
        "controller": {
          "title": "Controller",
          "type": "boolean"
        },
        "disk": {
          "title": "Disk",
          "type": "string"
        },
        "mac_addr": {
          "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$",
          "title": "Mac Addr",
          "type": "string"
        },
        "schematic_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schematic Id"
        },
        "mtu": {
          "default": 1500,
          "maximum": 9000,
          "minimum": 1450,
          "title": "Mtu",
          "type": "integer"
        },
        "secureboot": {
          "default": false,
          "title": "Secureboot",
          "type": "boolean"
        },
        "encrypt_disk": {
          "default": false,
          "title": "Encrypt Disk",
          "type": "boolean"
        },
        "kernel_modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kernel Modules",
          "type": "array"
        }
      },
      "required": ["name", "address", "controller", "disk", "mac_addr"],
      "title": "Node",
      "type": "object"
    },
    "Observability": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "discord": {
          "default": false,
          "title": "Discord",
          "type": "boolean"
        },
        "heartbeat": {
          "default": false,
          "title": "Heartbeat",
          "type": "boolean"
        },
        "grafana_oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Grafana Oidc Client Id",
          "type": "string"
        },
        "secret_key": {
          "default": false,
          "title": "Secret Key",
          "type": "boolean"
        },
        "github_app_id": {
          "default": "",
          "pattern": "^[0-9]*$",
          "title": "Github App Id",
          "type": "string"
        },
        "github_app_installation_id": {
          "default": "",
          "pattern": "^[0-9]*$",
          "title": "Github App Installation Id",
          "type": "string"
        },
        "sentry_org": {
          "default": "",
          "pattern": "^[a-z0-9-]*$",
          "title": "Sentry Org",
          "type": "string"
        },
        "sentry_url": {
          "default": "https://sentry.io",
          "pattern": "^https://[^/\\s]+$",
          "title": "Sentry Url",
          "type": "string"
        },
        "proxmox_hosts": {
          "default": [],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Proxmox Hosts",
          "type": "array"
        }
      },
      "title": "Observability",
      "type": "object"
    },
    "Onepassword": {
      "additionalProperties": false,
      "properties": {
        "vault": {
          "default": "",
          "pattern": "^[A-Za-z0-9_-]*$",
          "title": "Vault",
          "type": "string"
        }
      },
      "title": "Onepassword",
      "type": "object"
    },
    "PegaProx": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "metrics": {
          "default": false,
          "title": "Metrics",
          "type": "boolean"
        }
      },
      "title": "PegaProx",
      "type": "object"
    },
    "PocketId": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        }
      },
      "title": "PocketId",
      "type": "object"
    },
    "Postgres": {
      "additionalProperties": false,
      "properties": {
        "backup": {
          "$ref": "#/$defs/PostgresBackup",
          "default": {
            "endpoint": "",
            "bucket": ""
          }
        }
      },
      "title": "Postgres",
      "type": "object"
    },
    "PostgresBackup": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "default": "",
          "pattern": "^(https://[^/\\s]+)?$",
          "title": "Endpoint",
          "type": "string"
        },
        "bucket": {
          "default": "",
          "pattern": "^([a-z0-9][a-z0-9.-]*[a-z0-9])?$",
          "title": "Bucket",
          "type": "string"
        }
      },
      "title": "PostgresBackup",
      "type": "object"
    },
    "Radar": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        }
      },
      "title": "Radar",
      "type": "object"
    },
    "ReactiveResume": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "s3_bucket": {
          "default": "",
          "pattern": "^([a-z0-9][a-z0-9.-]*[a-z0-9])?$",
          "title": "S3 Bucket",
          "type": "string"
        }
      },
      "title": "ReactiveResume",
      "type": "object"
    },
    "Redis": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "Redis",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "webhook_provider": {
          "default": "github",
          "enum": ["github", "gitlab", "generic-hmac", "none"],
          "title": "Webhook Provider",
          "type": "string"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    },
    "RustFs": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "node": {
          "$ref": "#/$defs/WorkerName",
