{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Api": {
      "additionalProperties": false,
      "properties": {
        "addr": {
          "format": "ipv4",
          "title": "Addr",
          "type": "string"
        },
        "tls_sans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Fqdn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tls Sans"
        }
      },
      "required": ["addr"],
      "title": "Api",
      "type": "object"
    },
    "Asn": {
      "type": "string"
    },
    "Bgp": {
      "additionalProperties": false,
      "properties": {
        "router_addr": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Router Addr"
        },
        "router_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        },
        "node_asn": {
          "$ref": "#/$defs/Asn",
          "default": ""
        }
      },
      "title": "Bgp",
      "type": "object"
    },
    "Cidr": {
      "format": "ipv4network",
      "type": "string"
    },
    "Cilium": {
      "additionalProperties": false,
      "properties": {
        "loadbalancer_mode": {
          "default": "dsr",
          "enum": ["dsr", "snat"],
          "title": "Loadbalancer Mode",
          "type": "string"
        },
        "bgp": {
          "$ref": "#/$defs/Bgp",
          "default": {
            "router_addr": "",
            "router_asn": "",
            "node_asn": ""
          }
        },
        "hubble": {
          "$ref": "#/$defs/Hubble",
          "default": {
            "oidc_client_id": "",
            "oidc_client_secret": ""
          }
        }
      },
      "title": "Cilium",
      "type": "object"
    },
    "Dns": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "cloudflare",
          "enum": ["cloudflare", "none"],
          "title": "Provider",
          "type": "string"
        },
        "token": {
          "default": "",
          "title": "Token",
          "type": "string"
        }
      },
      "title": "Dns",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Fqdn"
        }
      },
      "required": ["name"],
      "title": "Domain",
      "type": "object"
    },
    "Fqdn": {
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$",
      "type": "string"
    },
    "Gateways": {
      "additionalProperties": false,
      "properties": {
        "internal": {
          "format": "ipv4",
          "title": "Internal",
          "type": "string"
        },
        "dns": {
          "format": "ipv4",
          "title": "Dns",
          "type": "string"
        },
        "external": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External"
        }
      },
      "required": ["internal", "dns"],
      "title": "Gateways",
      "type": "object"
    },
    "Hubble": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "oidc_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "Hubble",
      "type": "object"
    },
    "Ingress": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "cloudflare-tunnel",
          "enum": ["cloudflare-tunnel", "direct", "none"],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Ingress",
      "type": "object"
    },
    "Kener": {
      "additionalProperties": false,
      "properties": {
        "secret_key": {
          "default": "",
          "pattern": "^([^\"\\\\\\s$]{32,})?$",
          "title": "Secret Key",
          "type": "string"
        },
        "smtp_url": {
          "default": "",
          "pattern": "^(smtps?://[^\"\\\\\\s$]+)?$",
          "title": "Smtp Url",
          "type": "string"
        },
        "mail_from": {
          "default": "",
          "pattern": "^[^\"\\\\$\\r\\n]*$",
          "title": "Mail From",
          "type": "string"
        }
      },
      "title": "Kener",
      "type": "object"
    },
    "Kubernetes": {
      "additionalProperties": false,
      "properties": {
        "pod_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.42.0.0/16"
        },
        "svc_cidr": {
          "$ref": "#/$defs/Cidr",
          "default": "10.43.0.0/16"
        },
        "coredns_addr": {
          "format": "ipv4",
          "title": "Coredns Addr",
          "type": "string"
        },
        "api": {
          "$ref": "#/$defs/Api"
        }
      },
      "required": ["api"],
      "title": "Kubernetes",
      "type": "object"
    },
    "Matherlynet": {
      "additionalProperties": false,
      "properties": {
        "better_auth_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "admin_email": {
          "default": "",
          "pattern": "^([^@\\s\"\\\\$]+@[^@\\s\"\\\\$]+\\.[^@\\s\"\\\\$]+)?$",
          "title": "Admin Email",
          "type": "string"
        },
        "smtp_url": {
          "default": "",
          "pattern": "^(smtps?://[^\"\\\\\\s$]+)?$",
          "title": "Smtp Url",
          "type": "string"
        },
        "mail_from": {
          "default": "",
          "pattern": "^[^\"\\\\$\\r\\n]*$",
          "title": "Mail From",
          "type": "string"
        },
        "github_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Github Client Id",
          "type": "string"
        },
        "github_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "google_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Google Client Id",
          "type": "string"
        },
        "google_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "playground": {
          "default": false,
          "title": "Playground",
          "type": "boolean"
        }
      },
      "title": "Matherlynet",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "node_cidr": {
          "$ref": "#/$defs/Cidr"
        },
        "dns_servers": {
          "default": ["1.1.1.1", "1.0.0.1"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Dns Servers",
          "type": "array"
        },
        "ntp_servers": {
          "default": ["162.159.200.1", "162.159.200.123"],
          "items": {
            "format": "ipv4",
            "type": "string"
          },
          "title": "Ntp Servers",
          "type": "array"
        },
        "default_gateway": {
          "format": "ipv4",
          "title": "Default Gateway",
          "type": "string"
        },
        "vlan_tag": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlan Tag"
        }
      },
      "required": ["node_cidr"],
      "title": "Network",
      "type": "object"
    },
    "NetworkOptimizer": {
      "additionalProperties": false,
      "properties": {
        "app_password": {
          "default": "",
          "pattern": "^([^\"\\\\\\s$]{8,})?$",
          "title": "App Password",
          "type": "string"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "oidc_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "NetworkOptimizer",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$|^[a-z0-9]$",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "format": "ipv4",
          "title": "Address",
          "type": "string"
        },
        "controller": {
          "title": "Controller",
          "type": "boolean"
        },
        "disk": {
          "title": "Disk",
          "type": "string"
        },
        "mac_addr": {
          "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$",
          "title": "Mac Addr",
          "type": "string"
        },
        "schematic_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schematic Id"
        },
        "mtu": {
          "default": 1500,
          "maximum": 9000,
          "minimum": 1450,
          "title": "Mtu",
          "type": "integer"
        },
        "secureboot": {
          "default": false,
          "title": "Secureboot",
          "type": "boolean"
        },
        "encrypt_disk": {
          "default": false,
          "title": "Encrypt Disk",
          "type": "boolean"
        },
        "kernel_modules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Kernel Modules",
          "type": "array"
        }
      },
      "required": ["name", "address", "controller", "disk", "mac_addr"],
      "title": "Node",
      "type": "object"
    },
    "Observability": {
      "additionalProperties": false,
      "properties": {
        "grafana_password": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "influxdb_password": {
          "$ref": "#/$defs/Secret_________s___8_______",
          "default": ""
        },
        "influxdb_token": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "discord_webhook": {
          "default": "",
          "pattern": "^(https://discord(app)?\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+)?$",
          "title": "Discord Webhook",
          "type": "string"
        },
        "grafana_oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Grafana Oidc Client Id",
          "type": "string"
        },
        "grafana_oidc_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "Observability",
      "type": "object"
    },
    "PegaProx": {
      "additionalProperties": false,
      "properties": {
        "db_key": {
          "default": "",
          "pattern": "^([A-Za-z0-9_-]{43}=|[0-9a-fA-F]{64})?$",
          "title": "Db Key",
          "type": "string"
        },
        "metrics_token": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "PegaProx",
      "type": "object"
    },
    "PocketId": {
      "additionalProperties": false,
      "properties": {
        "encryption_key": {
          "default": "",
          "pattern": "^([^\"\\\\\\s$]{16,})?$",
          "title": "Encryption Key",
          "type": "string"
        },
        "public": {
          "default": false,
          "title": "Public",
          "type": "boolean"
        }
      },
      "title": "PocketId",
      "type": "object"
    },
    "Postgres": {
      "additionalProperties": false,
      "properties": {
        "backup": {
          "$ref": "#/$defs/PostgresBackup",
          "default": {
            "endpoint": "",
            "bucket": "",
            "access_key_id": "",
            "secret_access_key": ""
          }
        }
      },
      "title": "Postgres",
      "type": "object"
    },
    "PostgresBackup": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "default": "",
          "pattern": "^(https://[^/\\s]+)?$",
          "title": "Endpoint",
          "type": "string"
        },
        "bucket": {
          "default": "",
          "pattern": "^([a-z0-9][a-z0-9.-]*[a-z0-9])?$",
          "title": "Bucket",
          "type": "string"
        },
        "access_key_id": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "secret_access_key": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "PostgresBackup",
      "type": "object"
    },
    "Radar": {
      "additionalProperties": false,
      "properties": {
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "oidc_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "Radar",
      "type": "object"
    },
    "ReactiveResume": {
      "additionalProperties": false,
      "properties": {
        "auth_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "encryption_secret": {
          "default": "",
          "pattern": "^([^\"\\\\\\s$]{32,})?$",
          "title": "Encryption Secret",
          "type": "string"
        },
        "oidc_client_id": {
          "default": "",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "title": "Oidc Client Id",
          "type": "string"
        },
        "oidc_client_secret": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "s3_endpoint": {
          "default": "",
          "pattern": "^(https://[^/\\s]+)?$",
          "title": "S3 Endpoint",
          "type": "string"
        },
        "s3_bucket": {
          "default": "",
          "pattern": "^([a-z0-9][a-z0-9.-]*[a-z0-9])?$",
          "title": "S3 Bucket",
          "type": "string"
        },
        "s3_access_key_id": {
          "$ref": "#/$defs/Secret",
          "default": ""
        },
        "s3_secret_access_key": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "ReactiveResume",
      "type": "object"
    },
    "Redis": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "default": "",
          "pattern": "^([A-Za-z0-9]{24,})?$",
          "title": "Password",
          "type": "string"
        }
      },
      "title": "Redis",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^(https?://|ssh://git@)[^/]+/.+$",
          "title": "Url",
          "type": "string"
        },
        "branch": {
          "default": "main",
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "webhook_provider": {
          "default": "github",
          "enum": ["github", "gitlab", "generic-hmac", "none"],
          "title": "Webhook Provider",
          "type": "string"
        },
        "known_hosts": {
          "default": "",
          "title": "Known Hosts",
          "type": "string"
        }
      },
      "required": ["url"],
      "title": "Repository",
      "type": "object"
    },
    "Secret": {
      "pattern": "^[^\"\\\\\\s$]*$",
      "type": "string"
    },
    "Secret_________s___8_______": {
      "pattern": "^([^\"\\\\\\s$]{8,})?$",
      "type": "string"
    },
    "Spegel": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        }
      },
      "title": "Spegel",
      "type": "object"
    },
    "Talos": {
      "additionalProperties": false,
      "properties": {
        "schematic_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schematic Id"
        }
      },
      "title": "Talos",
      "type": "object"
    },
    "Unifi": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "default": "",
          "pattern": "^(https://[^/\\s]+)?$",
          "title": "Host",
          "type": "string"
        },
        "api_key": {
          "$ref": "#/$defs/Secret",
          "default": ""
        }
      },
      "title": "Unifi",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "network": {
      "$ref": "#/$defs/Network"
    },
    "kubernetes": {
      "$ref": "#/$defs/Kubernetes"
    },
    "gateways": {
      "$ref": "#/$defs/Gateways"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "dns": {
      "$ref": "#/$defs/Dns"
    },
    "ingress": {
      "$ref": "#/$defs/Ingress"
    },
    "cilium": {
      "$ref": "#/$defs/Cilium",
      "default": {
        "loadbalancer_mode": "dsr",
        "bgp": {
          "node_asn": "",
          "router_addr": "",
          "router_asn": ""
        },
        "hubble": {
          "oidc_client_id": "",
          "oidc_client_secret": ""
        }
      }
    },
    "talos": {
      "$ref": "#/$defs/Talos",
      "default": {
        "schematic_id": null
      }
    },
    "spegel": {
      "$ref": "#/$defs/Spegel",
      "default": {
        "enabled": null
      }
    },
    "postgres": {
      "$ref": "#/$defs/Postgres",
      "default": {
        "backup": {
          "access_key_id": "",
          "bucket": "",
          "endpoint": "",
          "secret_access_key": ""
        }
      }
    },
    "redis": {
      "$ref": "#/$defs/Redis",
      "default": {
        "password": ""
      }
    },
    "observability": {
      "$ref": "#/$defs/Observability",
      "default": {
        "grafana_password": "",
        "influxdb_password": "",
        "influxdb_token": "",
        "discord_webhook": "",
        "grafana_oidc_client_id": "",
        "grafana_oidc_client_secret": ""
      }
    },
    "unifi": {
      "$ref": "#/$defs/Unifi",
      "default": {
        "host": "",
        "api_key": ""
      }
    },
    "pocket_id": {
      "$ref": "#/$defs/PocketId",
      "default": {
        "encryption_key": "",
        "public": false
      }
    },
    "radar": {
      "$ref": "#/$defs/Radar",
      "default": {
        "oidc_client_id": "",
        "oidc_client_secret": ""
      }
    },
    "matherlynet": {
      "$ref": "#/$defs/Matherlynet",
      "default": {
        "better_auth_secret": "",
        "admin_email": "",
        "smtp_url": "",
        "mail_from": "",
        "github_client_id": "",
        "github_client_secret": "",
        "google_client_id": "",
        "google_client_secret": "",
        "playground": false
      }
    },
    "reactive_resume": {
      "$ref": "#/$defs/ReactiveResume",
      "default": {
        "auth_secret": "",
        "encryption_secret": "",
        "oidc_client_id": "",
        "oidc_client_secret": "",
        "s3_endpoint": "",
        "s3_bucket": "",
        "s3_access_key_id": "",
        "s3_secret_access_key": ""
      }
    },
    "kener": {
      "$ref": "#/$defs/Kener",
      "default": {
        "secret_key": "",
        "smtp_url": "",
        "mail_from": ""
      }
    },
    "network_optimizer": {
      "$ref": "#/$defs/NetworkOptimizer",
      "default": {
        "app_password": "",
        "oidc_client_id": "",
        "oidc_client_secret": ""
      }
    },
    "pegaprox": {
      "$ref": "#/$defs/PegaProx",
      "default": {
        "db_key": "",
        "metrics_token": ""
      }
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": ["network", "kubernetes", "gateways", "repository", "domain", "dns", "nodes"],
  "title": "cluster.toml",
  "type": "object"
}
