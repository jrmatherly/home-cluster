{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#8.1.0"],
  schedule: ["every weekend"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  mise: {
    managerFilePatterns: ["/^\\.mise/conf\\.d/[^/]+\\.toml$/"],
  },
  customManagers: [
    {
      description: "CloudNativePG extension image volumes (postgresql.extensions[].image.reference) are plain image references no built-in manager reads",
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: ["reference: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "LocalAI's main image and its llama-cpp backend image move together",
      matchDatasources: ["docker"],
      matchPackageNames: ["localai/localai", "quay.io/go-skynet/local-ai-backends"],
      groupName: "LocalAI",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Langfuse's web and worker images share a schema, which the web pod migrates on start",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/langfuse/langfuse", "docker.io/langfuse/langfuse-worker"],
      groupName: "Langfuse",
    },
    {
      description: "Network Optimizer previews are <semver>-preview<n>; read them as pre-releases, not a variant, so the stable release is offered",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/ozark-connect/network-optimizer"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-preview(?<prerelease>\\d+))?$",
    },
    {
      description: "Sonarr v5 tags are pre-releases upstream (gh release list -R Sonarr/Sonarr); drop this rule once a v5 tag is marked Latest",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/sonarr"],
      allowedVersions: "<5",
    },
    {
      description: "InfluxDB 3 is a different database (no Flux, other APIs); stay on 2.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/library/influxdb"],
      allowedVersions: "<3",
    },
    {
      description: "The docs image is rebuilt on every push to main: pin latest to its digest. pinDigests must sit in a rule without matchUpdateTypes, because update types are only known after the lookup that pinDigests steers",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jrmatherly/home-cluster/docs"],
      pinDigests: true,
    },
    {
      description: "Move the docs digest at once and merge without review. ignoreTests, because no workflow runs on a Renovate branch and the Docs Image workflow on main already built the image",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jrmatherly/home-cluster/docs"],
      matchUpdateTypes: ["pinDigest", "digest"],
      schedule: ["at any time"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: "TypeScript majors stay closed until @cloudflare/nimbus-docs (^5) and @astrojs/check (^5 || ^6) allow them",
      matchPackageNames: ["typescript"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
