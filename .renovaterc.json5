{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#8.1.0"],
  schedule: ["every weekend"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  mise: {
    managerFilePatterns: ["/^\\.mise/conf\\.d/[^/]+\\.toml$/"],
  },
  customManagers: [
    {
      description: "CloudNativePG extension image volumes (postgresql.extensions[].image.reference) are plain image references no built-in manager reads",
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: ["reference: (?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "LocalAI's main image and its llama-cpp backend image move together",
      matchDatasources: ["docker"],
      matchPackageNames: ["localai/localai", "quay.io/go-skynet/local-ai-backends"],
      groupName: "LocalAI",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Langfuse's web and worker images share a schema, which the web pod migrates on start",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/langfuse/langfuse", "docker.io/langfuse/langfuse-worker"],
      groupName: "Langfuse",
    },
    {
      description: "AI KB's chart and four images are released together under one CalVer tag",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/jrmatherly/ai-kb/charts/ai-kb",
        "ghcr.io/jrmatherly/ai-kb-app",
        "ghcr.io/jrmatherly/ai-kb-ui",
        "ghcr.io/jrmatherly/ai-kb-website",
        "ghcr.io/jrmatherly/ai-kb-docreader",
      ],
      groupName: "AI KB",
    },
    {
      description: "Network Optimizer previews are <semver>-preview<n>; read them as pre-releases, not a variant, so the stable release is offered",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/ozark-connect/network-optimizer"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-preview(?<prerelease>\\d+))?$",
    },
    {
      description: "SearXNG tags are <year>.<month>.<day>-<commit>; read the date as the version, because docker versioning takes the commit as a variant and never offers a newer day",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$",
    },
    {
      description: "Sonarr v5 tags are pre-releases upstream (gh release list -R Sonarr/Sonarr); drop this rule once a v5 tag is marked Latest",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/sonarr"],
      allowedVersions: "<5",
    },
    {
      description: "InfluxDB 3 is a different database (no Flux, other APIs); stay on 2.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/library/influxdb"],
      allowedVersions: "<3",
    },
    {
      description: "The docs image is rebuilt on every push to main: pin latest to its digest. pinDigests must sit in a rule without matchUpdateTypes, because update types are only known after the lookup that pinDigests steers",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jrmatherly/home-cluster/docs"],
      pinDigests: true,
    },
    {
      description: "Move the docs digest at once and merge without review. ignoreTests, because the preset merges it as a branch with no PR, Flate runs on pull_request only, so no check reports on that branch, and the Docs Image workflow on main already built the image",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jrmatherly/home-cluster/docs"],
      matchUpdateTypes: ["pinDigest", "digest"],
      schedule: ["at any time"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: "Tier 1 automerge, patch: apps whose merged history is version-only (PRs 33 to 92). PR mode and Renovate-side merge, because Flate runs on pull_request only and GitHub auto-merge would not wait for it. Weekend-only, so a merge never lands under the Monday update run. The talos tree is excluded because the kubelet pin is a docker pin Flate never checks",
      matchFileNames: ["kubernetes/**", "template/config/kubernetes/**"],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "!/^v?0\\./",
      matchPackageNames: [
        "ghcr.io/rajnandan1/kener",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/browserless/chromium",
        "docker.io/cloudflare/cloudflared",
        "ghcr.io/home-operations/charts/echo",
        "ghcr.io/home-operations/external-dns-unifi-webhook",
      ],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      automergeSchedule: ["every weekend"],
      platformAutomerge: false,
    },
    {
      description: "Tier 1 automerge, digest: a rebuild of the same tag, behind Flate on the weekend like the patch rule. The LocalAI images move inside their grouped PR, rustfs rc is pre-1.0 and its Job log once carried a secret, pegaprox and the Servarr builds are never automerged (references/apps.md), and the docs image keeps its own branch rule above, which this later rule would override",
      matchFileNames: ["kubernetes/**", "template/config/kubernetes/**"],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchCurrentVersion: "!/^v?0\\./",
      matchPackageNames: [
        "!localai/localai",
        "!quay.io/go-skynet/local-ai-backends",
        "!docker.io/rustfs/rc",
        "!ghcr.io/pegaprox/pegaprox",
        "!ghcr.io/home-operations/sonarr",
        "!ghcr.io/home-operations/radarr",
        "!ghcr.io/home-operations/prowlarr",
        "!ghcr.io/jrmatherly/home-cluster/docs",
      ],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      automergeSchedule: ["every weekend"],
      platformAutomerge: false,
    },
    {
      description: "Tier 1 automerge, docs Dockerfile digests: the Docs Image workflow builds every PR that touches docs/**, so it is the check",
      matchFileNames: ["docs/Dockerfile"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "pr",
      automergeSchedule: ["every weekend"],
      platformAutomerge: false,
    },
    {
      description: "TypeScript majors stay closed until @cloudflare/nimbus-docs (^5) and @astrojs/check (^5 || ^6) allow them",
      matchPackageNames: ["typescript"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
